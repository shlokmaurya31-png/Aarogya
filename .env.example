# ── Existing Aarogya (patient/doctor prototype + admin) ──────────────────────
ANTHROPIC_API_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Aarogya Scholar (student platform) ────────────────────────────────────────

# Prisma datasource. SQLite file for local dev — no Docker/Postgres needed.
# In production, point this at a managed Postgres instance and switch the
# datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Secret used to HMAC-sign session cookies (src/lib/auth/session.ts).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Which ClinicalCaseProvider is active (src/lib/clinical/config.ts).
# "synthetic" is the ONLY implemented mode. Any other value throws at boot —
# there is no code path that turns a real clinical feed on via env var alone.
# See docs/REAL_CLINICAL_DATA_INTEGRATION.md.
CLINICAL_DATA_MODE=synthetic

# Which AI backend src/lib/ai/provider.ts uses. "anthropic" requires
# ANTHROPIC_API_KEY above; "mock" (or ANTHROPIC_API_KEY unset) uses
# deterministic scripted responses so the app never hard-fails without a key.
AI_PROVIDER=anthropic

# Shows dev-only "Approve / Reject / Pending" verification shortcuts on
# /student/verify. Must never be enabled in a production build.
ENABLE_DEV_VERIFICATION=true

# ── Phase C1: ABDM / India digital health interoperability ──────────────
# DISABLED (default) | SANDBOX | PRODUCTION.
#
# DISABLED means Aarogya performs NO external calls: identifier mapping,
# consent and FHIR composition all still work locally, nothing is transmitted,
# and no identifier can be verified against a registry. Every clinical workflow
# is unaffected either way - interoperability is never a dependency of care.
#
# Anything unset or unrecognised is treated as DISABLED. A production build
# pointed at SANDBOX (or vice versa) is reported as unsafe and refuses to call.
ABDM_ENVIRONMENT=DISABLED

# Required only when ABDM_ENVIRONMENT is not DISABLED. Obtained through ABDM
# sandbox onboarding - see docs/PHASE_C1_INTEROPERABILITY.md section 8.
# NEVER commit real values; the secret is read from the environment only and is
# never persisted to the database.
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
