{
  "name": "aarogya-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db psql -U aarogya -d aarogya",
    "db:fresh": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "setup": "npm ci && node scripts/setup-env.mjs && npm run db:up && npm run db:fresh",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "verify:all": "tsx scripts/verify-all.ts",
    "docs:events": "tsx scripts/generate-event-catalogue.ts",
    "identity:migrate": "tsx scripts/identity-migrate.ts",
    "staging:migrate": "tsx scripts/staging.ts migrate",
    "staging:seed": "tsx scripts/staging.ts seed",
    "staging:check": "tsx scripts/staging.ts check",
    "staging:document": "tsx scripts/staging.ts document",
    "storage:init": "tsx scripts/storage.ts init",
    "storage:check": "tsx scripts/storage.ts check",
    "verification:migrate": "tsx scripts/migrate-verification-uploads.ts",
    "worker": "tsx scripts/worker.ts",
    "eval:documents": "tsx scripts/eval-documents.ts",
    "eval:documents:real": "tsx scripts/eval-documents-real.ts",
    "rag:reembed": "tsx scripts/rag-reembed.ts",
    "rag:backfill": "tsx scripts/rag-backfill.ts",
    "eval:rag": "tsx scripts/eval-rag.ts",
    "eval:rag:real": "tsx scripts/eval-rag.ts --provider real",
    "e2e:smoke": "tsx scripts/e2e-smoke.ts",
    "e2e": "tsx scripts/e2e-smoke.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@napi-rs/canvas": "1.0.10",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lenis": "^1.3.25",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.6.205",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "fontkit": "^2.0.4",
    "jsqr": "^1.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
