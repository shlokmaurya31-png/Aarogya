# Supabase staging (project region: ap-south-1, Mumbai).
#
# Copy to .env.staging.local (gitignored) and fill in real values:
#   cp .env.staging.example .env.staging.local
# Never commit .env.staging.local and never paste these values into chat,
# issues or logs. Where to find each value: docs/STAGING_SUPABASE.md.
#
# The staging:* and storage:* --staging scripts read ONLY this file for these
# values; nothing in .env or the shell is used for them.

# App connections: Supavisor TRANSACTION pooler (port 6543). `pgbouncer=true`
# makes Prisma skip prepared statements, which transaction pooling does not
# support.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations: Supavisor SESSION pooler (port 5432). It is IPv4-reachable,
# unlike the direct db.<project-ref>.supabase.co host, which is IPv6-only
# unless the IPv4 add-on is enabled.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Set to "yes" only for the one command you mean: STAGING_CONFIRM=yes npm run staging:seed
# (leave unset here so the seed can never run by accident)
# STAGING_CONFIRM=

# ── Storage: Supabase Storage over the S3 protocol ──────────────────────
# Dashboard → Project Settings → Storage → "S3 Connection": enable it, copy
# the endpoint and region, and generate an access key pair. These keys bypass
# Storage RLS: server-side only, never in the browser, never in git.
# One private bucket per logical bucket (src/lib/storage/types.ts); create
# them with: npm run storage:init -- --staging
STORAGE_S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
STORAGE_S3_REGION="ap-south-1"
STORAGE_S3_ACCESS_KEY_ID="<s3-access-key-id>"
STORAGE_S3_SECRET_ACCESS_KEY="<s3-secret-access-key>"
# Fixed for Supabase; the scripts refuse other values.
STORAGE_S3_FORCE_PATH_STYLE="true"
STORAGE_S3_BUCKET_PER_LOGICAL="true"
STORAGE_S3_CHECKSUMS="false"

# Public URL of the staging app (Vercel). QR codes on generated PDFs point at
# <APP_BASE_URL>/verify/<token>; staging:document fetches it.
APP_BASE_URL="https://<staging-app>.vercel.app"
