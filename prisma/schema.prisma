// Aarogya Scholar persistence layer.
//
// Datasource is SQLite for zero-setup local dev (no Docker/Postgres required).
// Every type used below (String/Int/Float/Boolean/DateTime/Json) has a direct
// Postgres equivalent, so moving to production is a one-line datasource change:
//   provider = "sqlite"
//   url      = env("DATABASE_URL")   // postgres://...
// See docs/STUDENT_PLATFORM_ARCHITECTURE.md §2.10 and
// docs/REAL_CLINICAL_DATA_INTEGRATION.md for the migration path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Identity & roles
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  PATIENT
  DOCTOR
  STUDENT
  EDUCATOR
  INSTITUTION_ADMIN
  AAROGYA_ADMIN
  // Hospital OS roles (see docs/ENTERPRISE_HOSPITAL_ARCHITECTURE.md §4 —
  // a deliberately narrowed subset of the brief's ~35-role list, matching
  // what Phase 1 actually implements).
  HOSPITAL_ADMIN
  NURSE
  LAB_TECHNICIAN
  RADIOLOGY_TECH
  PHARMACIST
  BILLING_STAFF
  // Phase 2 — Patient Flow: front-office registration/appointments/check-in.
  // Triage nurses, emergency doctors and bed managers are NOT separate
  // roles — they are NURSE/DOCTOR/HOSPITAL_ADMIN accounts with a
  // department/displayRole that says so (brief §66's "if role exists"),
  // consistent with "do not create duplicate users/roles unnecessarily".
  FRONT_DESK
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile       StudentProfile?
  hospitalStaffProfile HospitalStaffProfile?
  patientAccount       Patient?
  authoredCases        ClinicalCase[]         @relation("CaseAuthor")
  caseAttempts         CaseAttempt[]
  notebookEntries      NotebookEntry[]
  achievements         StudentAchievement[]
  auditEvents          AuditEvent[]
  competencies         StudentCompetency[]
  cohortMemberships    CohortMembership[]
  submissions          AssignmentSubmission[]

  @@index([role])
}

// ─────────────────────────────────────────────────────────────────────────
// Institutions & cohorts
// ─────────────────────────────────────────────────────────────────────────

model Institution {
  id        String              @id @default(cuid())
  name      String
  type      String // "medical-college" | "nursing-college" | "pharmacy-college" | "allied-health" | "university" | "other"
  city      String?
  domains   InstitutionDomain[]
  cohorts   Cohort[]
  students  StudentProfile[]
  createdAt DateTime            @default(now())
}

model InstitutionDomain {
  id            String      @id @default(cuid())
  domain        String      @unique // e.g. "aiimsdelhi.edu.in" — used by METHOD A academic-email verification
  institution   Institution @relation(fields: [institutionId], references: [id])
  institutionId String
}

model Cohort {
  id            String      @id @default(cuid())
  name          String // "MBBS 2027 — Internal Medicine Rotation B"
  institution   Institution @relation(fields: [institutionId], references: [id])
  institutionId String
  createdAt     DateTime    @default(now())

  memberships CohortMembership[]
  assignments Assignment[]
}

model CohortMembership {
  id       String   @id @default(cuid())
  cohort   Cohort   @relation(fields: [cohortId], references: [id])
  cohortId String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  joinedAt DateTime @default(now())

  @@unique([cohortId, userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Student verification (extends the existing VerificationApplication pattern
// used for doctor/lab/hospital in useAuthStore, now reviewed from the same
// admin queue for role="student")
// ─────────────────────────────────────────────────────────────────────────

enum VerificationStatus {
  UNVERIFIED
  EMAIL_PENDING
  DOCUMENT_PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  SUSPENDED
}

enum VerificationMethod {
  INSTITUTIONAL_EMAIL
  STUDENT_ID_CARD
  ENROLLMENT_DOCUMENT
  MANUAL_REVIEW
  ADMIN_INVITATION
}

enum Course {
  MBBS
  BDS
  BAMS
  BHMS
  BUMS
  BSC_NURSING
  GNM
  ANM
  PHARM_D
  B_PHARM
  M_PHARM
  BPT
  MPT
  OCCUPATIONAL_THERAPY
  RADIOLOGY_IMAGING
  MEDICAL_LAB_TECHNOLOGY
  PARAMEDICAL
  PUBLIC_HEALTH
  PSYCHOLOGY
  NUTRITION_DIETETICS
  OTHER
}

enum LearningTrack {
  MEDICINE
  NURSING
  PHARMACY
  DIAGNOSTICS
  PHYSIOTHERAPY
  PUBLIC_HEALTH
}

model StudentProfile {
  id                      String        @id @default(cuid())
  user                    User          @relation(fields: [userId], references: [id])
  userId                  String        @unique
  fullLegalName           String
  preferredName           String?
  institution             Institution?  @relation(fields: [institutionId], references: [id])
  institutionId           String?
  institutionNameFreeText String? // used before an Institution row is matched/created
  course                  Course
  learningTrack           LearningTrack
  specialization          String?
  academicYear            Int
  enrollmentYear          Int
  expectedGraduation      Int
  studentIdentifier       String?
  institutionEmail        String?
  currentRotation         String?
  clinicalInterests       String // JSON-encoded string[]

  verificationStatus VerificationStatus  @default(UNVERIFIED)
  verificationMethod VerificationMethod?
  verifiedAt         DateTime?
  expiresAt          DateTime?

  streakDays   Int       @default(0)
  clinicalXp   Int       @default(0)
  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verification VerificationDocument[]
}

// Verification documents are stored out-of-band (see src/lib/verification/provider.ts);
// this table records only a reference, hash and status — never raw bytes, and is never
// joined into any response the student or the general case-browsing UI can see.
model VerificationDocument {
  id               String         @id @default(cuid())
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  studentProfileId String
  kind             String // "student-id-card" | "enrollment-letter" | ...
  storageRef       String // opaque path in the restricted local upload store
  sha256           String
  uploadedAt       DateTime       @default(now())
  reviewedByAdmin  Boolean        @default(false)
  reviewNote       String?
}

// ─────────────────────────────────────────────────────────────────────────
// Clinical Learning Data Gateway output: the educational case itself.
// This table NEVER stores source-patient identifiers. See
// docs/CLINICAL_EDUCATION_PRIVACY.md.
// ─────────────────────────────────────────────────────────────────────────

enum CaseSourceType {
  SYNTHETIC
  DEIDENTIFIED_CLINICAL
  HISTORICAL_TEACHING
  INSTITUTION_AUTHORED
}

enum Difficulty {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
  RESIDENT_LEVEL
  EXPERT
}

enum Acuity {
  ROUTINE
  URGENT
  EMERGENCY
}

model ClinicalCase {
  id            String         @id @default(cuid())
  slug          String         @unique // e.g. "EDU-CARD-STEMI-001"
  title         String
  specialty     String
  subspecialty  String?
  difficulty    Difficulty
  acuity        Acuity
  sourceType    CaseSourceType @default(SYNTHETIC)
  learnerTracks String // JSON-encoded LearningTrack[]

  // Educational patient (never a real identity — see educationalIdentity.ts)
  patientName     String
  patientAgeBand  String
  patientAgeExact Int?
  patientSex      String

  chiefComplaint     String
  learningObjectives String // JSON string[]

  // Full case content — server-only fields live here and are stripped by
  // src/lib/caseEngine/publicView.ts before ever reaching an HTTP response
  // that isn't already gated by "attempt is submitted".
  content     Json // { presentation, historyTree, examFindings, investigations, imaging, management, prescriptionReference, redFlags, criticalActions, unsafeActions, debrief }
  referenceDx String
  rubric      Json // ScoringRubric
  viva        Json // VivaQuestion[]

  author      User?    @relation("CaseAuthor", fields: [authorId], references: [id])
  authorId    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempts    CaseAttempt[]
  assignments Assignment[]

  @@index([specialty])
  @@index([difficulty])
}

// ─────────────────────────────────────────────────────────────────────────
// Case attempts (the state machine instance) & actions (audit + replay log)
// ─────────────────────────────────────────────────────────────────────────

enum CaseStage {
  TRIAGE
  HISTORY
  PHYSICAL
  DIFFERENTIAL
  INVESTIGATIONS
  INTERPRETATION
  DIAGNOSIS
  MANAGEMENT
  PRESCRIPTION
  MONITORING
  DISPOSITION
  DOCUMENTATION
  VIVA
  DEBRIEF
  COMPLETE
}

enum AttemptMode {
  PRACTICE
  EXAM
}

model CaseAttempt {
  id             String       @id @default(cuid())
  case           ClinicalCase @relation(fields: [caseId], references: [id])
  caseId         String
  student        User         @relation(fields: [studentId], references: [id])
  studentId      String
  mode           AttemptMode  @default(PRACTICE)
  stage          CaseStage    @default(TRIAGE)
  revealedState  Json // accumulated facts the engine has unlocked for this attempt
  differential   Json? // student-submitted ranked differential
  diagnosis      String?
  managementPlan Json?
  prescriptions  Json? // RxLab entries submitted within this case
  hintsUsed      Int          @default(0)
  score          Json? // computed CaseScoreBreakdown once submitted
  startedAt      DateTime     @default(now())
  submittedAt    DateTime?

  actions CaseAction[]

  @@index([studentId])
  @@index([caseId])
}

model CaseAction {
  id         String      @id @default(cuid())
  attempt    CaseAttempt @relation(fields: [attemptId], references: [id])
  attemptId  String
  stage      CaseStage
  type       String // "ask-history" | "select-exam" | "order-investigation" | "submit-differential" | "hint" | ...
  payload    Json
  scoreDelta Float?
  createdAt  DateTime    @default(now())

  @@index([attemptId])
}

// ─────────────────────────────────────────────────────────────────────────
// Competency tracking, achievements
// ─────────────────────────────────────────────────────────────────────────

model StudentCompetency {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  domain    String // "Clinical Reasoning" | "History Taking" | ...
  score     Float    @default(0) // 0-100 rolling
  attempts  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, domain])
}

model Achievement {
  id          String @id @default(cuid())
  code        String @unique // "FIRST_DIAGNOSIS" | "SEVEN_DAY_STREAK" | ...
  title       String
  description String
  icon        String

  studentAchievements StudentAchievement[]
}

model StudentAchievement {
  id            String      @id @default(cuid())
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  achievementId String
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
}

// ─────────────────────────────────────────────────────────────────────────
// Notebook, recommendations, assignments, audit
// ─────────────────────────────────────────────────────────────────────────

model NotebookEntry {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  body      String
  specialty String?
  caseId    String?
  tags      String // JSON string[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearningRecommendation {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  caseIds   String // JSON string[]
  createdAt DateTime @default(now())
}

model Assignment {
  id        String       @id @default(cuid())
  cohort    Cohort       @relation(fields: [cohortId], references: [id])
  cohortId  String
  case      ClinicalCase @relation(fields: [caseId], references: [id])
  caseId    String
  dueAt     DateTime?
  minScore  Int?
  createdAt DateTime     @default(now())

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId String
  student      User       @relation(fields: [studentId], references: [id])
  studentId    String
  attemptId    String?
  submittedAt  DateTime   @default(now())
}

model AuditEvent {
  id        String   @id @default(cuid())
  type      String // "student.verification.submitted" | "student.case.opened" | ...
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  detail    Json?
  createdAt DateTime @default(now())

  // Phase 4.5 hardening: structured context for tenant/patient-scoped audit
  // queries, replacing "join through detail JSON" as the only way to filter.
  // Nullable — historical rows predate these columns and are never
  // backfilled (detail JSON isn't structured consistently enough to
  // deterministically derive them; see docs/PHASE_4_5_INTEGRITY_GATE.md).
  facilityId  String?
  facility    Facility? @relation(fields: [facilityId], references: [id])
  patientId   String?
  patient     Patient?  @relation(fields: [patientId], references: [id])
  encounterId String?

  @@index([type])
  @@index([userId])
  @@index([facilityId])
  @@index([patientId])
  @@index([encounterId])
}

// ─────────────────────────────────────────────────────────────────────────
// Aarogya Hospital OS — tenancy, beds, staff
// See docs/ENTERPRISE_HOSPITAL_ARCHITECTURE.md for the full design and for
// why this lives under /hospital-os rather than the pre-existing /hospital
// mock portal (untouched — see architecture doc §1.1).
// ─────────────────────────────────────────────────────────────────────────

model Organization {
  id         String     @id @default(cuid())
  name       String
  createdAt  DateTime   @default(now())
  facilities Facility[]
}

model Facility {
  id             String       @id @default(cuid())
  name           String
  city           String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime     @default(now())

  departments               Department[]
  wards                     Ward[]
  beds                      Bed[]
  staff                     HospitalStaffProfile[]
  patients                  Patient[]
  encounters                Encounter[]
  episodesOfCare            EpisodeOfCare[]
  charges                   Charge[]
  tasks                     Task[]
  documents                 ClinicalDocument[]
  appointments              Appointment[]
  scheduleBlocks            DoctorScheduleBlock[]
  queueEntries              QueueEntry[]
  triageAssessments         TriageAssessment[]
  encounterLocations        EncounterLocation[]
  admissionRequests         AdmissionRequest[]
  transferRequests          TransferRequest[]
  slaPolicies               SlaPolicy[]
  orders                    Order[]
  carePlans                 CarePlan[]
  handoffs                  ClinicalHandoff[]
  nursingAssignments        NursingAssignment[]
  nursingAssessments        NursingAssessment[]
  vitalThresholds           VitalThreshold[]
  intakeOutputRecords       IntakeOutputRecord[]
  medicationReconciliations MedicationReconciliation[]

  // Phase B1 — ICU Foundation.
  icuUnits        IcuUnit[]
  icuObservations IcuObservation[]
  icuDevices      IcuDevice[]
  icuInfusions    IcuInfusion[]

  // Phase B3 — Operating Theatre.
  procedures        Procedure[]
  operatingTheatres OperatingTheatre[]
  surgeries         Surgery[]

  // Phase B4 — Blood Bank & Transfusion.
  bloodProducts BloodProduct[]
  bloodUnits    BloodUnit[]
  bloodRequests BloodRequest[]
  transfusions  Transfusion[]

  // Phase 4 Milestone B — Laboratory core workflow (brief §6-24).
  specimens       Specimen[]
  labTestCatalogs LabTestCatalog[]
  labPanels       LabPanel[]

  // Phase 4 Milestone C — Radiology core workflow.
  imagingStudies   ImagingStudy[]
  imagingCatalogs  ImagingCatalog[]
  imagingResources ImagingResource[]

  // Phase 4.5 — structured audit context (see AuditEvent).
  auditEvents AuditEvent[]

  // Phase 5 — Billing + Insurance + Revenue Cycle.
  billingAccounts  BillingAccount[]
  tariffs          Tariff[]
  packages         PackageDefinition[]
  invoices         Invoice[]
  invoiceSequences InvoiceSequence[]
  payments         Payment[]
  claims           Claim[]

  // Phase 6A — Inventory + Procurement Foundation.
  items                  Item[]
  itemLots               ItemLot[]
  stockLocations         StockLocation[]
  stockLedgerEntries     StockLedgerEntry[]
  stockBalances          StockBalance[]
  stockReservations      StockReservation[]
  stockTransfers         StockTransfer[]
  stockAdjustments       StockAdjustment[]
  wasteRecords           WasteRecord[]
  stockTakes             StockTake[]
  suppliers              Supplier[]
  purchaseRequisitions   PurchaseRequisition[]
  purchaseOrders         PurchaseOrder[]
  goodsReceipts          GoodsReceipt[]
  requisitionSequences   PurchaseRequisitionSequence[]
  purchaseOrderSequences PurchaseOrderSequence[]
  goodsReceiptSequences  GoodsReceiptSequence[]
  medicationItemLinks    MedicationItemLink[]
  formularyEntries       FormularyEntry[]
}

model Department {
  id         String   @id @default(cuid())
  name       String
  code       String?
  facility   Facility @relation(fields: [facilityId], references: [id])
  facilityId String
  createdAt  DateTime @default(now())

  wards                Ward[]
  staff                HospitalStaffProfile[]
  encounters           Encounter[]
  memberships          DepartmentMembership[]
  referralsFrom        Referral[]             @relation("ReferralFromDept")
  referralsTo          Referral[]             @relation("ReferralToDept")
  tasks                Task[]
  appointments         Appointment[]
  scheduleBlocks       DoctorScheduleBlock[]
  queueEntries         QueueEntry[]
  admissionRequests    AdmissionRequest[]
  nursingAssignments   NursingAssignment[]
  purchaseRequisitions PurchaseRequisition[]

  @@unique([facilityId, name])
}

/**
 * A staff member's *primary* facility/department/role lives on
 * HospitalStaffProfile (the common case — one person, one home
 * department). DepartmentMembership additionally grants a staff member
 * standing in OTHER departments at the same facility (brief §5's "Dr.
 * Sharma: Cardiology + Emergency" example) without the larger structural
 * change of a full multi-facility membership model, which nothing in the
 * current system needs yet — see docs/CLINICAL_CORE.md §2.
 */
model DepartmentMembership {
  id           String               @id @default(cuid())
  staff        HospitalStaffProfile @relation(fields: [staffId], references: [id])
  staffId      String
  department   Department           @relation(fields: [departmentId], references: [id])
  departmentId String
  createdAt    DateTime             @default(now())

  @@unique([staffId, departmentId])
  @@index([departmentId])
}

enum WardType {
  GENERAL
  ICU
  HDU
  NICU
  PICU
  EMERGENCY
  PRIVATE
  SEMI_PRIVATE
  ISOLATION
  OT_RECOVERY
}

model Ward {
  id           String      @id @default(cuid())
  name         String
  wardType     WardType
  facility     Facility    @relation(fields: [facilityId], references: [id])
  facilityId   String
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  createdAt    DateTime    @default(now())

  beds Bed[]

  @@unique([facilityId, name])
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  BLOCKED
  MAINTENANCE
  ISOLATION
  TRANSFER_PENDING
}

model Bed {
  id                String    @id @default(cuid())
  label             String
  ward              Ward      @relation(fields: [wardId], references: [id])
  wardId            String
  facility          Facility  @relation(fields: [facilityId], references: [id])
  facilityId        String
  status            BedStatus @default(AVAILABLE)
  genderRestriction String? // "male" | "female" | null (no restriction)
  isolationRequired Boolean   @default(false)
  // Phase B1 — ICU bed capabilities (resource-matching attributes, not
  // clinical decisions). The bed stays the canonical bed; these are
  // additive booleans + an optional link to the ICU unit that owns it.
  icuCapable        Boolean   @default(false)
  ventilatorCapable Boolean   @default(false)
  negativePressure  Boolean   @default(false)
  icuUnit           IcuUnit?  @relation(fields: [icuUnitId], references: [id])
  icuUnitId         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  stateEvents        BedStateEvent[]
  admissions         Admission[]
  transfersFrom      Transfer[]          @relation("TransferFromBed")
  transfersTo        Transfer[]          @relation("TransferToBed")
  admissionRequests  AdmissionRequest[]
  transferRequests   TransferRequest[]
  encounterLocations EncounterLocation[]
  nursingAssignments NursingAssignment[]

  @@unique([facilityId, label])
  @@index([status])
}

model BedStateEvent {
  id          String    @id @default(cuid())
  bed         Bed       @relation(fields: [bedId], references: [id])
  bedId       String
  fromStatus  BedStatus
  toStatus    BedStatus
  reason      String?
  patientId   String?
  encounterId String?
  byUserId    String?
  createdAt   DateTime  @default(now())

  @@index([bedId])
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model HospitalStaffProfile {
  id            String      @id @default(cuid())
  user          User        @relation(fields: [userId], references: [id])
  userId        String      @unique
  facility      Facility    @relation(fields: [facilityId], references: [id])
  facilityId    String
  department    Department? @relation(fields: [departmentId], references: [id])
  departmentId  String?
  displayRole   String // human label e.g. "Cardiologist", "ICU Nurse", "Lab Technician"
  employeeId    String?
  specialty     String?
  licenseNumber String?
  licenseExpiry DateTime?
  status        StaffStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())

  encountersAttended         Encounter[]                @relation("AttendingStaff")
  admissionsCreated          Admission[]                @relation("AdmittingStaff")
  notes                      ClinicalNote[]             @relation("NoteAuthor")
  medicationOrders           MedicationOrder[]          @relation("MedicationOrderer")
  medicationAdmins           MedicationAdministration[] @relation("MedicationAdministrator")
  labOrders                  LabOrder[]                 @relation("LabOrderer")
  labResultsReleased         LabResult[]                @relation("LabResultReleaser")
  imagingOrders              ImagingOrder[]             @relation("ImagingOrderer")
  imagingReports             ImagingReport[]            @relation("ImagingReporter")
  departmentMemberships      DepartmentMembership[]
  diagnosesRecorded          Diagnosis[]
  tasksCreated               Task[]                     @relation("TaskCreatedBy")
  tasksOwned                 Task[]                     @relation("TaskOwner")
  tasksCompleted             Task[]                     @relation("TaskCompletedBy")
  documentsAuthored          ClinicalDocument[]         @relation("DocumentAuthor")
  documentsUploaded          ClinicalDocument[]         @relation("DocumentUploadedBy")
  consentsRecorded           Consent[]
  referralsMade              Referral[]                 @relation("ReferralFromStaff")
  referralsReceived          Referral[]                 @relation("ReferralToStaff")
  patientMerges              PatientMergeRecord[]
  appointmentsAsDoctor       Appointment[]              @relation("AppointmentDoctor")
  scheduleBlocks             DoctorScheduleBlock[]
  queueEntriesAsPractitioner QueueEntry[]               @relation("QueuePractitioner")
  triageAssessments          TriageAssessment[]
  admissionRequestsMade      AdmissionRequest[]         @relation("AdmissionRequestedBy")
  admissionRequestsReviewed  AdmissionRequest[]         @relation("AdmissionReviewedBy")
  transferRequestsMade       TransferRequest[]          @relation("TransferRequestedBy")
  transferRequestsAccepted   TransferRequest[]          @relation("TransferAcceptedBy")
  ordersPlaced               Order[]
  handoffsGiven              ClinicalHandoff[]          @relation("HandoffFrom")
  handoffsReceived           ClinicalHandoff[]          @relation("HandoffTo")
  nursingAssignments         NursingAssignment[]        @relation("NurseAssigned")
  nursingAssessments         NursingAssessment[]        @relation("NursingAssessmentNurse")
  medicationVerifications    MedicationVerification[]
  dispensingRecords          DispensingRecord[]         @relation("DispensingPharmacist")
  dispensingWitnessed        DispensingRecord[]         @relation("DispensingWitness")
  administrationsWitnessed   MedicationAdministration[] @relation("AdministrationWitness")

  @@index([facilityId])
}

// ─────────────────────────────────────────────────────────────────────────
// Patient master + longitudinal encounter record
// ─────────────────────────────────────────────────────────────────────────

model Patient {
  id                      String    @id @default(cuid())
  uhid                    String    @unique
  facility                Facility  @relation(fields: [facilityId], references: [id])
  facilityId              String
  fullName                String // primary/legal display name — kept as the existing field name rather than
  // renamed to "legalName" to avoid a large, purely-cosmetic blast radius
  // across every route/seed/UI already built on it. See docs/CLINICAL_CORE.md §1.
  preferredName           String?
  sex                     String
  dob                     DateTime?
  dobPrecision            String? // "EXACT" | "APPROXIMATE" | "UNKNOWN" — null means EXACT for legacy rows
  ageYears                Int?
  phone                   String?
  address                 String?
  language                String?   @default("en")
  communicationPreference String? // "SMS" | "EMAIL" | "CALL" | "NONE"
  bloodGroup              String?
  registrationStatus      String    @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  deceasedAt              DateTime?

  // Self-service portal linkage (Phase 1: Role.PATIENT accounts) — nullable because most
  // patients today are registered by staff and have no login of their own yet.
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  // Logical merge (brief §10) — never destructive. A merged patient's row is kept, marked,
  // and its clinical history is included when the target patient's record is read (see
  // src/lib/patient/merge.ts). Nothing physically deletes or reassigns FKs.
  mergedInto   Patient?  @relation("PatientMerge", fields: [mergedIntoId], references: [id])
  mergedIntoId String?
  mergedFrom   Patient[] @relation("PatientMerge")
  mergedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identifiers               PatientIdentifier[]
  emergencyContacts         PatientEmergencyContact[]
  allergies                 Allergy[]
  problems                  Problem[]
  diagnoses                 Diagnosis[]
  episodesOfCare            EpisodeOfCare[]
  encounters                Encounter[]
  medicationOrders          MedicationOrder[]
  labOrders                 LabOrder[]
  imagingOrders             ImagingOrder[]
  charges                   Charge[]
  tasks                     Task[]
  documents                 ClinicalDocument[]
  consents                  Consent[]
  referrals                 Referral[]
  mergeRecordsAsSource      PatientMergeRecord[]       @relation("MergeSource")
  mergeRecordsAsTarget      PatientMergeRecord[]       @relation("MergeTarget")
  appointments              Appointment[]
  queueEntries              QueueEntry[]
  admissionRequests         AdmissionRequest[]
  transferRequests          TransferRequest[]
  orders                    Order[]
  carePlans                 CarePlan[]
  handoffs                  ClinicalHandoff[]
  nursingAssignments        NursingAssignment[]
  nursingAssessments        NursingAssessment[]
  medicationReconciliations MedicationReconciliation[]
  specimens                 Specimen[]
  imagingStudies            ImagingStudy[]

  // Phase B1 — ICU Foundation.
  icuObservations IcuObservation[]
  icuDevices      IcuDevice[]
  icuInfusions    IcuInfusion[]

  // Phase B3 — Operating Theatre.
  surgeries Surgery[]

  // Phase B4 — Blood Bank & Transfusion.
  bloodRequests BloodRequest[]

  // Phase 4.5 — structured audit context (see AuditEvent).
  auditEvents AuditEvent[]

  // Phase 5 — Billing + Insurance + Revenue Cycle.
  billingAccounts BillingAccount[]
  coverages       PatientCoverage[]
  payments        Payment[]
  invoices        Invoice[]

  @@index([facilityId])
  @@index([mergedIntoId])
}

model PatientEmergencyContact {
  id        String  @id @default(cuid())
  patient   Patient @relation(fields: [patientId], references: [id])
  patientId String
  name      String
  relation  String
  phone     String
  priority  Int     @default(1)

  @@index([patientId])
}

model PatientIdentifier {
  id        String   @id @default(cuid())
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId String
  type      String // "ABHA" | "INSURANCE_MEMBER_ID" | "EXTERNAL_MRN"
  value     String
  issuer    String?
  status    String   @default("ACTIVE") // "ACTIVE" | "INVALID" | "SUPERSEDED"
  createdAt DateTime @default(now())

  @@index([patientId])
}

model Allergy {
  id           String   @id @default(cuid())
  patient      Patient  @relation(fields: [patientId], references: [id])
  patientId    String
  substance    String
  reaction     String?
  severity     String // "mild" | "moderate" | "severe"
  status       String   @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "ENTERED_IN_ERROR"
  verification String   @default("UNCONFIRMED") // "UNCONFIRMED" | "CONFIRMED"
  recordedAt   DateTime @default(now())

  @@index([patientId])
}

/**
 * Episode of Care (brief §11 / docs/TARGET_DOMAIN_ARCHITECTURE.md §2.1):
 * groups related encounters around one clinical problem or journey (e.g. a
 * chronic-disease management arc, or a surgical journey from pre-op through
 * follow-up). Optional on Encounter — most encounters today have no episode
 * and that's fine; this is additive, not required.
 */
model EpisodeOfCare {
  id         String    @id @default(cuid())
  patient    Patient   @relation(fields: [patientId], references: [id])
  patientId  String
  facility   Facility  @relation(fields: [facilityId], references: [id])
  facilityId String
  title      String
  type       String // "CHRONIC_DISEASE" | "SURGICAL" | "ACUTE" | "MATERNITY" | "ONCOLOGY" | "OTHER"
  status     String    @default("ACTIVE") // "ACTIVE" | "CLOSED"
  reason     String?
  openedAt   DateTime  @default(now())
  closedAt   DateTime?

  encounters Encounter[]

  @@index([patientId])
  @@index([facilityId])
}

/**
 * Distinct from Problem (docs/TARGET_DOMAIN_ARCHITECTURE.md): a Diagnosis
 * is a specific diagnostic assertion tied to one encounter, with a
 * type/certainty; a Problem is a longer-lived item on the patient's
 * problem list that persists across encounters. A diagnosis can promote a
 * new entry onto the problem list, but the two are not the same row.
 */
model Diagnosis {
  id                 String               @id @default(cuid())
  patient            Patient              @relation(fields: [patientId], references: [id])
  patientId          String
  encounter          Encounter            @relation(fields: [encounterId], references: [id])
  encounterId        String
  diagnosis          String
  type               String // "PRIMARY" | "SECONDARY" | "PROVISIONAL" | "RULE_OUT" | "FINAL"
  status             String               @default("ACTIVE") // "ACTIVE" | "RESOLVED" | "ENTERED_IN_ERROR"
  onsetDate          DateTime?
  codeSystem         String? // e.g. "ICD-10" — nullable, no terminology integrated yet (see TARGET_DOMAIN_ARCHITECTURE.md §3)
  code               String?
  diagnosedBy        HospitalStaffProfile @relation(fields: [diagnosedByStaffId], references: [id])
  diagnosedByStaffId String
  createdAt          DateTime             @default(now())

  @@index([patientId])
  @@index([encounterId])
}

enum EncounterType {
  OPD
  ED
  IPD
  DAYCARE
  TELEMEDICINE
}

enum EncounterStatus {
  REGISTERED
  TRIAGED
  IN_CONSULTATION
  INVESTIGATING
  ADMITTED
  DISCHARGED
  CLOSED
  CANCELLED
}

model Encounter {
  id               String                @id @default(cuid())
  patient          Patient               @relation(fields: [patientId], references: [id])
  patientId        String
  facility         Facility              @relation(fields: [facilityId], references: [id])
  facilityId       String
  department       Department?           @relation(fields: [departmentId], references: [id])
  departmentId     String?
  episodeOfCare    EpisodeOfCare?        @relation(fields: [episodeOfCareId], references: [id])
  episodeOfCareId  String?
  type             EncounterType
  status           EncounterStatus       @default(REGISTERED)
  chiefComplaint   String?
  triageLevel      Int? // 1 (resuscitation) - 5 (non-urgent), ED only
  attendingStaff   HospitalStaffProfile? @relation("AttendingStaff", fields: [attendingStaffId], references: [id])
  attendingStaffId String?
  registeredAt     DateTime              @default(now())
  closedAt         DateTime?
  cancelledReason  String?

  // Phase 2 — Patient Flow arrival/access metadata (brief §6/§18/§45-47).
  // Nullable, encounter-scoped fields rather than a separate "EDArrival"
  // table — these are 1:1 with an encounter and most are only meaningful
  // for ED/emergency arrivals, matching how Patient's nullable fields were
  // extended in Phase 1 rather than splitting into a new table.
  accessSource          AccessSource?
  arrivalMode           String? // "WALK_IN" | "AMBULANCE" | "WHEELCHAIR" | "STRETCHER"
  traumaIndicator       Boolean       @default(false)
  ambulanceRef          String? // ambulance identifier (brief §47) — data capture only, no live integration
  accompanyingPerson    String?
  referringProviderName String? // external referral intake (brief §46) — full referral management deferred
  referringFacilityName String?
  referralUrgency       String?

  vitals                    Vital[]
  notes                     ClinicalNote[]
  diagnoses                 Diagnosis[]
  medicationOrders          MedicationOrder[]
  labOrders                 LabOrder[]
  imagingOrders             ImagingOrder[]
  referrals                 Referral[]
  documents                 ClinicalDocument[]
  admission                 Admission?
  charges                   Charge[]
  billingAccount            BillingAccount?
  preAuthorizations         PreAuthorization[]
  invoices                  Invoice[]
  appointments              Appointment[]
  triageAssessments         TriageAssessment[]
  queueEntries              QueueEntry[]
  locations                 EncounterLocation[]
  admissionRequests         AdmissionRequest[]
  orders                    Order[]
  carePlans                 CarePlan[]
  handoffs                  ClinicalHandoff[]
  nursingAssignments        NursingAssignment[]
  nursingAssessments        NursingAssessment[]
  intakeOutputRecords       IntakeOutputRecord[]
  medicationReconciliations MedicationReconciliation[]
  specimens                 Specimen[]
  imagingStudies            ImagingStudy[]

  // Phase B1 — ICU Foundation.
  icuObservations IcuObservation[]
  icuDevices      IcuDevice[]
  icuInfusions    IcuInfusion[]

  // Phase B3 — Operating Theatre.
  surgeries Surgery[]

  // Phase B4 — Blood Bank & Transfusion.
  bloodRequests BloodRequest[]

  // Phase B5 — Emergency Department.
  edReassessments  EdReassessment[]
  edResuscitations EdResuscitation[]
  edDisposition    EdDisposition?

  @@index([facilityId])
  @@index([episodeOfCareId])
  @@index([status])
  @@index([patientId])
}

model Admission {
  id               String               @id @default(cuid())
  encounter        Encounter            @relation(fields: [encounterId], references: [id])
  encounterId      String               @unique
  bed              Bed                  @relation(fields: [bedId], references: [id])
  bedId            String
  reason           String
  // Phase 6.8 (brief §14) — admission context. Free-string per the repo's
  // enum-as-documented-string convention (cf. EncounterType comments):
  // "ELECTIVE" | "EMERGENCY" | "DAYCARE" | "OBSERVATION" | "MATERNITY" |
  // "PEDIATRIC" | "ISOLATION" | "REFERRAL". Nullable — legacy rows and
  // admissions that don't specify one stay null.
  admissionType    String?
  expectedLosDays  Int?
  admittingStaff   HospitalStaffProfile @relation("AdmittingStaff", fields: [admittingStaffId], references: [id])
  admittingStaffId String
  admittedAt       DateTime             @default(now())

  transfers        Transfer[]
  discharge        Discharge?
  admissionRequest AdmissionRequest?
  transferRequests TransferRequest[]

  @@index([bedId])
}

model Transfer {
  id            String    @id @default(cuid())
  admission     Admission @relation(fields: [admissionId], references: [id])
  admissionId   String
  fromBed       Bed       @relation("TransferFromBed", fields: [fromBedId], references: [id])
  fromBedId     String
  toBed         Bed       @relation("TransferToBed", fields: [toBedId], references: [id])
  toBedId       String
  reason        String
  byUserId      String
  transferredAt DateTime  @default(now())

  transferRequest TransferRequest?

  @@index([admissionId])
}

model Discharge {
  id                 String    @id @default(cuid())
  admission          Admission @relation(fields: [admissionId], references: [id])
  admissionId        String    @unique
  // Phase 6.8 (brief §18) — discharge context. Free-string per repo
  // convention: "ROUTINE" | "LAMA" | "DAMA" | "ABSCONDED" | "DEATH" |
  // "TRANSFER" | "REFERRAL". Nullable until finalized.
  dischargeType      String?
  clinicallyReady    Boolean   @default(false)
  documentationReady Boolean   @default(false)
  billingReady       Boolean   @default(false)
  insuranceReady     Boolean   @default(false)
  pharmacyReady      Boolean   @default(false)
  transportReady     Boolean   @default(false)
  dischargeSummary   Json?
  signedByStaffId    String?
  initiatedAt        DateTime  @default(now())
  dischargedAt       DateTime?

  // Phase 2 — discharge planning (brief §37/§39). Blockers themselves are
  // NOT a stored field — see src/lib/hospital/dischargeBarrierEngine.ts,
  // computed live from these readiness flags plus pending
  // lab/imaging/referral state, matching this repo's established
  // computed-aggregation-over-duplicated-table pattern (docs/CLINICAL_CORE.md §4).
  initiatedByStaffId      String?
  expectedDischargeAt     DateTime?
  expectedDischargeReason String?
}

model ClinicalNote {
  id              String               @id @default(cuid())
  encounter       Encounter            @relation(fields: [encounterId], references: [id])
  encounterId     String
  author          HospitalStaffProfile @relation("NoteAuthor", fields: [authorStaffId], references: [id])
  authorStaffId   String
  // "SOAP" | "PROGRESS" | "ADMISSION" | "CONSULT" | "DISCHARGE_SUMMARY" | "HANDOVER" | "DAILY_ROUND" | "PROCEDURE" | "FOLLOW_UP" (brief §4 note types — free text, same convention as before)
  type            String
  // structured + narrative (brief §5): content may hold any of presentingComplaint/hpi/pastMedicalHistory/
  // surgicalHistory/familyHistory/socialHistory/examination/assessment/diagnosis/treatmentPlan/
  // investigationPlan/medicationPlan/followUpPlan as optional keys, or just free narrative — never forced into one rigid shape.
  content         Json
  status          String               @default("SIGNED") // "DRAFT" | "SIGNED" | "AMENDED" | "SUPERSEDED"
  supersedesId    String?
  authorRole      String? // denormalized at creation time (brief §4 "author role") — a later role change doesn't retroactively alter history
  createdAt       DateTime             @default(now())
  signedAt        DateTime?
  amendedAt       DateTime?
  amendmentReason String?

  @@index([encounterId])
}

model Problem {
  id        String    @id @default(cuid())
  patient   Patient   @relation(fields: [patientId], references: [id])
  patientId String
  diagnosis String
  status    String // "active" | "resolved" | "suspected"
  severity  String?
  onsetDate DateTime?
  createdAt DateTime  @default(now())

  @@index([patientId])
}

model Vital {
  id                String    @id @default(cuid())
  encounter         Encounter @relation(fields: [encounterId], references: [id])
  encounterId       String
  recordedByStaffId String
  hr                Int?
  sbp               Int?
  dbp               Int?
  rr                Int?
  spo2              Int?
  tempC             Float?
  painScore         Int?
  // Phase 3 (brief §13) — free-text, not a coded scale (never inventing GCS/AVPU semantics).
  consciousness     String?
  o2DeliveryMethod  String? // "room air" | "nasal cannula" | "face mask" | ...
  o2FlowRate        Float?
  recordedAt        DateTime  @default(now())

  @@index([encounterId])
}

// ─────────────────────────────────────────────────────────────────────────
// Orders: medication, lab, imaging
// ─────────────────────────────────────────────────────────────────────────

model MedicationOrder {
  id               String                @id @default(cuid())
  encounter        Encounter             @relation(fields: [encounterId], references: [id])
  encounterId      String
  patient          Patient               @relation(fields: [patientId], references: [id])
  patientId        String
  drugName         String
  genericName      String?
  dose             String
  route            String
  frequency        String
  durationDays     Int?
  orderedBy        HospitalStaffProfile  @relation("MedicationOrderer", fields: [orderedByStaffId], references: [id])
  orderedByStaffId String
  status           MedicationOrderStatus @default(ORDERED)
  safetyFlags      Json? // CDS output at order time (Phase 0) — see src/lib/hospital/clinicalSafety.ts; MedicationSafetyWarning (Phase 3) is the actionable/auditable version of this
  overrideReason   String?
  orderedAt        DateTime              @default(now())

  // Phase 3 — medication lifecycle deepening (brief §15). All nullable/defaulted so
  // every pre-Phase-3 row (dose/route/frequency as free strings, status="ORDERED") keeps working unchanged.
  order                 Order?    @relation(fields: [orderId], references: [id])
  orderId               String?   @unique
  formulation           String?
  strengthValue         Float?
  strengthUnit          String?
  doseValue             Float?
  doseUnit              String?
  timing                String?
  startAt               DateTime?
  stopAt                DateTime?
  prn                   Boolean   @default(false)
  prnReason             String?
  specialInstructions   String?
  indication            String?
  isControlled          Boolean   @default(false)
  discontinuedAt        DateTime?
  discontinuedReason    String?
  discontinuedByStaffId String?
  cancelledAt           DateTime?
  cancelledReason       String?
  cancelledByStaffId    String?

  // Phase B6 — enterprise pharmacy dispense tracking (all additive). A target
  // quantity enables partial/multi-lot dispensing bounds; dispensedQuantity is
  // a guarded accumulator (atomic conditional UPDATE, same idiom as
  // StockBalance) so cumulative dispensing can never exceed the target under
  // concurrency. Null target = the pre-B6 unbounded behaviour, unchanged.
  dispenseTargetQuantity Float?
  dispenseTargetUnit     String?
  dispensedQuantity      Float   @default(0)

  administrations   MedicationAdministration[]
  safetyWarnings    MedicationSafetyWarning[]
  verifications     MedicationVerification[]
  dispensingRecords DispensingRecord[]
  returns           MedicationReturn[] // Phase B6
  substitutions     MedicationSubstitution[] // Phase B6

  @@index([encounterId])
  @@index([patientId])
  @@index([status])
}

model MedicationAdministration {
  id                    String                         @id @default(cuid())
  medicationOrder       MedicationOrder                @relation(fields: [medicationOrderId], references: [id])
  medicationOrderId     String
  administeredBy        HospitalStaffProfile?          @relation("MedicationAdministrator", fields: [administeredByStaffId], references: [id])
  administeredByStaffId String?
  scheduledAt           DateTime
  administeredAt        DateTime?
  status                MedicationAdministrationStatus @default(DUE)
  notes                 String?
  // Phase 3 additions — REFUSED/CANCELLED are new capability (brief §20); GIVEN kept
  // as-is rather than renamed to ADMINISTERED, matching the existing working
  // vocabulary every current route/seed/UI reads (docs/PHASE_3_ARCHITECTURE.md §5).
  reasonCode            String? // category for HELD/REFUSED/MISSED, e.g. "patient-declined" | "npo" | "unavailable"
  witnessStaffId        String? // controlled-medication co-sign (brief §25)
  witness               HospitalStaffProfile?          @relation("AdministrationWitness", fields: [witnessStaffId], references: [id])
  safetyChecksConfirmed Boolean                        @default(false)

  @@index([medicationOrderId])
  @@index([status])
}

model LabOrder {
  id               String               @id @default(cuid())
  encounter        Encounter            @relation(fields: [encounterId], references: [id])
  encounterId      String
  patient          Patient              @relation(fields: [patientId], references: [id])
  patientId        String
  testName         String
  category         String
  priority         String               @default("ROUTINE") // ROUTINE | URGENT | STAT
  orderedBy        HospitalStaffProfile @relation("LabOrderer", fields: [orderedByStaffId], references: [id])
  orderedByStaffId String
  status           LabOrderStatus       @default(ORDERED)
  orderedAt        DateTime             @default(now())

  // Phase 4 — generalized Order envelope link (brief §3), mirrors
  // MedicationOrder.orderId exactly.
  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String? @unique

  // Phase 4 Milestone B (brief §7-11) — optional structured-catalog link.
  // Nullable so every existing/simple free-text order (testName/category)
  // keeps working completely unchanged; only orders placed through the new
  // catalog/panel picker set these.
  catalogTest   LabTestCatalog? @relation(fields: [catalogTestId], references: [id])
  catalogTestId String?
  panel         LabPanel?       @relation(fields: [panelId], references: [id])
  panelId       String?

  // One specimen per order this milestone (brief §11-15); the FK is not
  // unique so the schema itself doesn't block a future multi-specimen
  // panel workflow.
  specimens Specimen[]
  results   LabResult[]

  @@index([encounterId])
  @@index([status])
}

model LabResult {
  id                    String                @id @default(cuid())
  labOrder              LabOrder              @relation(fields: [labOrderId], references: [id])
  labOrderId            String
  value                 String
  unit                  String?
  referenceRange        String?
  isCritical            Boolean               @default(false)
  releasedBy            HospitalStaffProfile? @relation("LabResultReleaser", fields: [releasedByStaffId], references: [id])
  releasedByStaffId     String?
  resultedAt            DateTime              @default(now())
  acknowledgedByStaffId String?
  acknowledgedAt        DateTime?

  // Phase 4 Milestone B (brief §17-19, §21) — structured result entry +
  // versioning/amendment. Every field here is nullable/defaulted so all
  // pre-Milestone-B rows (value as free string, resultType=null,
  // status=ENTERED, version=1, isCurrent=true) keep working unchanged.
  specimen      Specimen?       @relation(fields: [specimenId], references: [id])
  specimenId    String?
  catalogTest   LabTestCatalog? @relation(fields: [catalogTestId], references: [id])
  catalogTestId String? // which panel member this row is for; null = simple single-test order
  resultType    LabResultType?
  numericValue  Float?
  abnormalFlag  AbnormalFlag? // computed server-side only when a LabReferenceRange exists — never invented

  status            LabResultStatus @default(ENTERED)
  verifiedByStaffId String?
  verifiedAt        DateTime?

  // Amendment chain (brief §18) — a verified result is never edited in
  // place. Amending creates a NEW row (version N+1, isCurrent=true) and
  // flips this row to isCurrent=false; the original stays byte-for-byte
  // intact and readable forever.
  version           Int        @default(1)
  isCurrent         Boolean    @default(true)
  previousVersion   LabResult? @relation("LabResultVersion", fields: [previousVersionId], references: [id])
  previousVersionId String?    @unique
  supersededBy      LabResult? @relation("LabResultVersion")
  amendedReason     String?
  amendedByStaffId  String?
  amendedAt         DateTime?

  @@index([labOrderId])
  @@index([specimenId])
  @@index([isCurrent])
  @@index([isCritical, acknowledgedAt, isCurrent])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 4 Milestone B — Laboratory core workflow: catalog, panels,
// reference ranges, specimen lifecycle. See docs/PHASE_4_DIAGNOSTICS_ARCHITECTURE.md.
// ─────────────────────────────────────────────────────────────────────────

model LabTestCatalog {
  id           String        @id @default(cuid())
  facility     Facility?     @relation(fields: [facilityId], references: [id])
  facilityId   String? // null = available to every facility
  code         String        @unique
  name         String
  category     String
  specimenType String
  resultType   LabResultType
  unit         String?
  // Clearly a demo/placeholder figure, not a real hospital price list —
  // exists only so the auto-charge-on-order hook (brief §44) has an amount.
  demoPriceInr Float         @default(300)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())

  panelMemberships LabPanelTest[]
  referenceRanges  LabReferenceRange[]
  labOrders        LabOrder[]
  labResults       LabResult[]

  @@index([facilityId])
  @@index([category])
}

model LabPanel {
  id         String    @id @default(cuid())
  facility   Facility? @relation(fields: [facilityId], references: [id])
  facilityId String?
  code       String    @unique
  name       String
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  tests     LabPanelTest[]
  labOrders LabOrder[]

  @@index([facilityId])
}

model LabPanelTest {
  id            String         @id @default(cuid())
  panel         LabPanel       @relation(fields: [panelId], references: [id])
  panelId       String
  catalogTest   LabTestCatalog @relation(fields: [catalogTestId], references: [id])
  catalogTestId String

  @@unique([panelId, catalogTestId])
}

/**
 * Configurable reference range for a catalog test (brief §9). Deliberately
 * NOT hardcoded into any UI component — every consumer must read this
 * table. `isDemoData`/`sourceNote` exist so seeded ranges are never
 * mistaken for a clinically-validated reference standard (brief's explicit
 * clinical-safety instruction).
 */
model LabReferenceRange {
  id            String         @id @default(cuid())
  catalogTest   LabTestCatalog @relation(fields: [catalogTestId], references: [id])
  catalogTestId String
  low           Float?
  high          Float?
  criticalLow   Float?
  criticalHigh  Float?
  unit          String?
  sex           String? // "male" | "female" | null = applies to any sex
  minAgeYears   Int?
  maxAgeYears   Int?
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?
  isDemoData    Boolean        @default(true)
  sourceNote    String         @default("Demo/reference configuration — not clinically validated")

  @@index([catalogTestId])
}

/**
 * Specimen lifecycle (brief §12-15): ORDERED -> COLLECTION_PENDING ->
 * COLLECTED -> RECEIVED -> ACCEPTED -> IN_PROCESS -> RESULTED -> ARCHIVED,
 * with REJECTED/LOST/CANCELLED/RECOLLECTION_REQUIRED exception states.
 * A rejected specimen is never edited or deleted — recollection creates a
 * NEW row linked back via recollectionOfSpecimenId, preserving full history.
 */
model Specimen {
  id          String    @id @default(cuid())
  labOrder    LabOrder  @relation(fields: [labOrderId], references: [id])
  labOrderId  String
  facility    Facility  @relation(fields: [facilityId], references: [id])
  facilityId  String
  patient     Patient   @relation(fields: [patientId], references: [id])
  patientId   String
  encounter   Encounter @relation(fields: [encounterId], references: [id])
  encounterId String

  accessionNumber String
  specimenType    String
  status          SpecimenStatus @default(ORDERED)

  // Phase B7 — specimen identity. `barcode` is the scannable value (defaulted
  // to the accession number at accession time); accessionNumber stays the
  // human-readable identifier. `containerType` is documentary (tube/container).
  // A barcode is never sufficient authorization — every mutation still
  // re-validates facility/patient/encounter/order ownership server-side.
  barcode       String?
  containerType String?

  collectedByStaffId String?
  collectedAt        DateTime?
  collectionNotes    String?

  receivedByStaffId String?
  receivedAt        DateTime?

  acceptedByStaffId String?
  acceptedAt        DateTime?

  rejectedReason    SpecimenRejectionReason?
  rejectedNotes     String?
  rejectedByStaffId String?
  rejectedAt        DateTime?

  // Recollection (brief §15) — points back at the original rejected
  // specimen; the original row is never modified or removed.
  // @unique closes a Milestone E hardening finding: without it, two
  // concurrent recollect requests against the same rejected specimen can
  // both pass the app-level "no recollection yet" check and both create a
  // recollection row (NULL values are exempt from uniqueness, so
  // never-recollected specimens are unaffected).
  recollectionOf           Specimen?  @relation("SpecimenRecollection", fields: [recollectionOfSpecimenId], references: [id])
  recollectionOfSpecimenId String?    @unique
  recollections            Specimen[] @relation("SpecimenRecollection")

  createdAt DateTime @default(now())

  results LabResult[]

  @@unique([facilityId, accessionNumber])
  @@index([labOrderId])
  @@index([status])
  @@index([patientId])
  @@index([facilityId, status])
}

enum LabResultType {
  NUMERIC
  TEXT
  CATEGORICAL
  POSITIVE_NEGATIVE
}

enum AbnormalFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH
  ABNORMAL
}

enum LabResultStatus {
  ENTERED
  VERIFIED
  AMENDED
  SUPERSEDED
}

enum SpecimenStatus {
  ORDERED
  COLLECTION_PENDING
  COLLECTED
  RECEIVED
  ACCEPTED
  IN_PROCESS
  RESULTED
  ARCHIVED
  REJECTED
  LOST
  CANCELLED
  RECOLLECTION_REQUIRED
}

enum SpecimenRejectionReason {
  INSUFFICIENT_SPECIMEN
  WRONG_CONTAINER
  HEMOLYZED
  MISLABELED
  LEAKED
  EXPIRED_TRANSPORT
  INCORRECT_SPECIMEN_TYPE
  OTHER
}

model ImagingOrder {
  id               String               @id @default(cuid())
  encounter        Encounter            @relation(fields: [encounterId], references: [id])
  encounterId      String
  patient          Patient              @relation(fields: [patientId], references: [id])
  patientId        String
  modality         String // XRAY | CT | MRI | USG | MAMMOGRAPHY | INTERVENTIONAL
  studyDescription String
  priority         String               @default("ROUTINE")
  orderedBy        HospitalStaffProfile @relation("ImagingOrderer", fields: [orderedByStaffId], references: [id])
  orderedByStaffId String
  status           ImagingOrderStatus   @default(ORDERED)
  orderedAt        DateTime             @default(now())

  // Phase 4 — generalized Order envelope link (brief §3), mirrors
  // MedicationOrder.orderId exactly.
  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String? @unique

  // Phase 4 Milestone C (brief §4) — optional structured-catalog link.
  // Nullable so every existing/simple free-text order (modality/
  // studyDescription) keeps working completely unchanged; only orders
  // placed through the new catalog picker set this.
  catalogStudy   ImagingCatalog? @relation(fields: [catalogStudyId], references: [id])
  catalogStudyId String?

  // One study per order this milestone (brief §7); the FK is not unique so
  // the schema itself doesn't block a future multi-study workflow.
  studies ImagingStudy[]
  reports ImagingReport[]

  @@index([encounterId])
  @@index([status])
}

/**
 * The performed study occurrence (brief §7) — distinct from ImagingOrder,
 * which only represents the request. Carries the fine-grained
 * scheduling/execution lifecycle so ImagingOrder.status can stay coarse,
 * mirroring the Order/MedicationOrder and LabOrder/Specimen precedent.
 * Internal accessionNumber only this milestone — StudyInstanceUID/PACS
 * fields are a clean future addition, not implemented now (brief §7/§31).
 */
model ImagingStudy {
  id             String       @id @default(cuid())
  imagingOrder   ImagingOrder @relation(fields: [imagingOrderId], references: [id])
  imagingOrderId String
  facility       Facility     @relation(fields: [facilityId], references: [id])
  facilityId     String
  patient        Patient      @relation(fields: [patientId], references: [id])
  patientId      String
  encounter      Encounter    @relation(fields: [encounterId], references: [id])
  encounterId    String

  accessionNumber String
  modality        String
  bodyRegion      String?
  status          ImagingStudyStatus @default(SCHEDULED)

  resource   ImagingResource? @relation(fields: [resourceId], references: [id])
  resourceId String?

  scheduledAt    DateTime
  // Phase 4.5 hardening: half-open interval end [scheduledAt, scheduledEndAt)
  // used for real overlap detection (see imagingStudyLifecycle.ts) instead of
  // the old exact-timestamp-equality check. Backfilled to scheduledAt+30min
  // for pre-existing rows (see migration).
  scheduledEndAt DateTime
  arrivedAt      DateTime?
  startedAt      DateTime?
  performedAt    DateTime?

  performedByStaffId String?

  contrastRequired Boolean @default(false)
  contrastGiven    Boolean @default(false)

  // Phase B7 — DICOM/PACS BOUNDARY (metadata + external-resource reference
  // only; NOT a DICOM server or image store). studyInstanceUid/seriesUid are
  // recorded identifiers; pacsReference is an opaque external-viewer/resource
  // handle; imageAvailability tracks whether images exist in the external PACS
  // ("NONE" | "PENDING" | "AVAILABLE"). dicomMetadata holds recorded tag values
  // as JSON — no image bytes ever live in this database.
  studyInstanceUid  String?
  seriesUid         String?
  numberOfImages    Int?
  pacsReference     String?
  imageAvailability String    @default("NONE")
  acquisitionAt     DateTime?
  technicalNotes    String?
  dicomMetadata     Json?

  // Structured safety/prep capture only (brief §10) — never an autonomous
  // clinical decision, just workflow checkboxes a technologist ticks.
  pregnancyScreened    Boolean @default(false)
  allergyScreened      Boolean @default(false)
  mriSafetyScreened    Boolean @default(false)
  implantScreened      Boolean @default(false)
  preparationCompleted Boolean @default(false)

  cancelledReason String?
  notes           String?

  createdAt DateTime @default(now())

  reports ImagingReport[]

  @@unique([facilityId, accessionNumber])
  @@index([imagingOrderId])
  @@index([status])
  @@index([resourceId, scheduledAt])
  @@index([facilityId, status])
}

/**
 * Report lifecycle (brief §11-12): ENTERED -> VERIFIED, with amendment
 * spawning a new versioned row (never editing a verified report in
 * place) — mirrors LabResult's Milestone B amendment pattern conceptually,
 * not by sharing a table. "Verify" (sign-off) is deliberately separate
 * from "acknowledge" (critical-finding clearance, brief §13) — the
 * original schema conflated these via a single verifiedAt, which also
 * left the imaging:report:verify permission dead (no route enforced it).
 */
model ImagingReport {
  id             String        @id @default(cuid())
  // Nullable: the 5 pre-Milestone-C ImagingReport rows predate ImagingStudy
  // entirely (verified against live data before migration — see
  // docs/PHASE_4_DIAGNOSTICS_ARCHITECTURE.md) and simply have no study to
  // point at, same reasoning as LabResult.specimenId. Every report created
  // through the new report-entry route always sets this (enforced at the
  // application level, requiring the study to be COMPLETED first).
  study          ImagingStudy? @relation(fields: [studyId], references: [id])
  studyId        String?
  // Denormalized for query convenience, matching Specimen's pattern —
  // source of truth for "which study" is studyId above.
  imagingOrder   ImagingOrder  @relation(fields: [imagingOrderId], references: [id])
  imagingOrderId String

  indication      String?
  technique       String?
  findings        String
  impression      String
  recommendations String?

  isCritical Boolean @default(false)

  reportedBy        HospitalStaffProfile @relation("ImagingReporter", fields: [reportedByStaffId], references: [id])
  reportedByStaffId String
  reportedAt        DateTime             @default(now())

  status            ImagingReportStatus @default(ENTERED)
  verifiedByStaffId String?
  verifiedAt        DateTime?

  acknowledgedByStaffId String?
  acknowledgedAt        DateTime?

  version           Int            @default(1)
  isCurrent         Boolean        @default(true)
  previousVersion   ImagingReport? @relation("ImagingReportVersion", fields: [previousVersionId], references: [id])
  previousVersionId String?        @unique
  supersededBy      ImagingReport? @relation("ImagingReportVersion")
  amendedReason     String?
  amendedByStaffId  String?
  amendedAt         DateTime?

  @@index([studyId])
  @@index([imagingOrderId])
  @@index([isCurrent])
  @@index([isCritical, acknowledgedAt, isCurrent])
}

/**
 * Structured imaging catalog (brief §4) — deliberately minimal, not a
 * DICOM attribute registry. demoPriceInr exists only so the auto-charge
 * hook has an amount, same caveat as LabTestCatalog.demoPriceInr.
 */
model ImagingCatalog {
  id                     String    @id @default(cuid())
  facility               Facility? @relation(fields: [facilityId], references: [id])
  facilityId             String? // null = available to every facility
  code                   String    @unique
  name                   String
  modality               String
  bodyRegion             String?
  description            String?
  contrastRequired       Boolean   @default(false)
  prepInstructions       String?
  defaultDurationMinutes Int       @default(30)
  demoPriceInr           Float     @default(1500)
  active                 Boolean   @default(true)
  createdAt              DateTime  @default(now())

  imagingOrders ImagingOrder[]

  @@index([facilityId])
  @@index([modality])
}

/**
 * A bookable modality/room (brief §8) — deliberately minimal, a
 * schedulable resource, not a DICOM AE-title/device registry.
 */
model ImagingResource {
  id         String   @id @default(cuid())
  facility   Facility @relation(fields: [facilityId], references: [id])
  facilityId String
  name       String
  modality   String
  active     Boolean  @default(true)

  // Phase B7 — schedulable-resource metadata (still not a DICOM AE-title/device
  // registry — deeper biomedical/equipment management is a later phase).
  roomLabel    String?
  location     String?
  capabilities Json?

  studies ImagingStudy[]

  @@index([facilityId])
}

enum ImagingStudyStatus {
  SCHEDULED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ImagingReportStatus {
  ENTERED
  VERIFIED
  AMENDED
  SUPERSEDED
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 5 — Billing + Insurance + Revenue Cycle.
// See docs/PHASE_5_BILLING_ARCHITECTURE.md for the full design. Money
// convention throughout this section: every amount is an integer minor
// unit (`xxxMinor`, INR paise) — never a Float. `Bill`'s old mutable
// running-total counters (totalAmount/paidAmount, incremented on every
// charge with no reconciliation against actual payments) are retired in
// favor of BillingAccount, which stores no totals at all — every summary
// is computed live from Charge/Invoice/Payment/Refund/FinancialAdjustment,
// the same "don't store what can go stale" philosophy already used by
// dischargeBarrierEngine.ts.
// ─────────────────────────────────────────────────────────────────────────

enum ChargeStatus {
  POSTED
  VOIDED
}

/**
 * A billable financial event derived from clinical activity. Never mutates
 * the clinical record it derives from — provenance is carried via
 * sourceType/sourceId (e.g. "LabOrder"/<id>, "DispensingRecord"/<id>,
 * "AdmissionBedDay"/<admissionId>, "PackageApplication"/"<pkgId>:<encId>").
 * Once POSTED, unitPriceMinor/discountMinor/netAmountMinor/chargeCode/
 * sourceType/sourceId are immutable — the only legal transition is
 * POSTED -> VOIDED (see chargeCapture.ts#voidCharge), and only while not
 * yet folded into an issued InvoiceLine.
 */
model Charge {
  id          String    @id @default(cuid())
  encounter   Encounter @relation(fields: [encounterId], references: [id])
  encounterId String
  patient     Patient   @relation(fields: [patientId], references: [id])
  patientId   String
  facility    Facility  @relation(fields: [facilityId], references: [id])
  facilityId  String
  description String
  category    String // CONSULTATION | BED | PROCEDURE | LAB | IMAGING | PHARMACY | NURSING | PACKAGE | OTHER

  // Links to Tariff.chargeCode (e.g. LabTestCatalog.code, ImagingCatalog.code,
  // "BED_DAY:<WardType>", "PHARMACY:<DRUGNAME>") — null only for a legacy/
  // freeform manual charge predating this phase or an explicitly-authorized
  // freeform override (see billing:adjustment:approve gate in the manual
  // billing route).
  chargeCode     String?
  quantity       Float        @default(1)
  unitPriceMinor Int          @default(0)
  discountMinor  Int          @default(0)
  netAmountMinor Int          @default(0) // (quantity * unitPriceMinor) - discountMinor
  currency       String       @default("INR")
  status         ChargeStatus @default(POSTED)

  sourceType String? // e.g. "LabOrder", "MedicationOrder"
  sourceId   String?

  postedByUserId String? // null = system/automatic (order-creation/dispense/discharge hooks)
  voidedAt       DateTime?
  voidedByUserId String?
  voidReason     String?

  createdAt DateTime @default(now())

  invoiceLine InvoiceLine?

  // Milestone E hardening (Phase 4): closes the duplicate-billing gap —
  // createChargeIfNotExists's app-level findFirst-then-create check could
  // not fully close on its own (NULL sourceType/sourceId — manual charges
  // — are exempt from uniqueness, so this only constrains the
  // auto-charge-on-order path, which is exactly where it's needed).
  @@unique([sourceType, sourceId])
  @@index([encounterId])
  @@index([facilityId, status])
}

enum BillingAccountStatus {
  OPEN
  CLOSED
}

/**
 * Pure grouping/anchor row for one encounter's financial activity — NOT a
 * ledger, NOT a totals cache. See billingAccount.ts#computeAccountSummary
 * for how balances are derived live. Created lazily on first charge via
 * getOrCreateBillingAccount, same call-site shape as the old Bill upsert.
 */
model BillingAccount {
  id          String               @id @default(cuid())
  encounter   Encounter            @relation(fields: [encounterId], references: [id])
  encounterId String               @unique
  patient     Patient              @relation(fields: [patientId], references: [id])
  patientId   String
  facility    Facility             @relation(fields: [facilityId], references: [id])
  facilityId  String
  status      BillingAccountStatus @default(OPEN)
  openedAt    DateTime             @default(now())
  closedAt    DateTime?

  invoices Invoice[]
  payments Payment[]

  @@index([facilityId, status])
}

enum PayerType {
  CASH
  INSURANCE
  GOVERNMENT_SCHEME
  CORPORATE_TPA
}

/**
 * Generic payer abstraction — not just "insurer". A single seeded sentinel
 * row (name: "Cash / Self-Pay", type: CASH) backs every self-pay Tariff/
 * Invoice, deliberately avoiding a nullable payerId on Tariff (see below —
 * a Postgres exclusion constraint over a nullable column is awkward, so
 * self-pay is a real Payer row instead of null).
 */
model Payer {
  id        String    @id @default(cuid())
  name      String
  type      PayerType
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  plans     PayerPlan[]
  tariffs   Tariff[]
  coverages PatientCoverage[]
  invoices  Invoice[]
}

model PayerPlan {
  id           String  @id @default(cuid())
  payer        Payer   @relation(fields: [payerId], references: [id])
  payerId      String
  name         String
  planCode     String?
  copayPercent Float?
  active       Boolean @default(true)

  coverages PatientCoverage[]

  @@unique([payerId, name])
}

enum CoverageStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model PatientCoverage {
  id            String         @id @default(cuid())
  patient       Patient        @relation(fields: [patientId], references: [id])
  patientId     String
  payer         Payer          @relation(fields: [payerId], references: [id])
  payerId       String
  plan          PayerPlan?     @relation(fields: [planId], references: [id])
  planId        String?
  memberId      String
  validFrom     DateTime
  validTo       DateTime?
  priorityOrder Int            @default(1) // 1 = primary; 2+ = secondary payers, tried in order
  status        CoverageStatus @default(ACTIVE)
  addedByUserId String
  createdAt     DateTime       @default(now())

  preAuths PreAuthorization[]
  claims   Claim[]

  @@unique([patientId, payerId, memberId])
  @@index([patientId, status])
}

enum PreAuthStatus {
  REQUESTED
  APPROVED
  DENIED
  EXPIRED
}

/**
 * Foundation only — no live payer API. Status is set manually by staff
 * reading the payer's decision off-system; EXPIRED is a status a human
 * sets, never an auto-transition (this codebase has no cron/background
 * job anywhere) — staleness is instead surfaced as a live-computed warning
 * in financialClearance.ts, matching dischargeBarrierEngine.ts's pattern.
 */
model PreAuthorization {
  id                   String          @id @default(cuid())
  coverage             PatientCoverage @relation(fields: [coverageId], references: [id])
  coverageId           String
  encounter            Encounter       @relation(fields: [encounterId], references: [id])
  encounterId          String
  requestedAmountMinor Int
  approvedAmountMinor  Int?
  status               PreAuthStatus   @default(REQUESTED)
  payerReferenceNo     String? // payer's own reference — manual entry, no live API
  requestedAt          DateTime        @default(now())
  decidedAt            DateTime?
  notes                String?
  requestedByUserId    String

  claim Claim?

  @@index([encounterId])
}

/**
 * Facility-scoped price list entry. facilityId and payerId are both
 * deliberately NOT nullable — self-pay uses the seeded CASH Payer sentinel
 * above rather than payerId: null, because a Postgres exclusion constraint
 * (see prisma/migrations-postgres-baseline) over nullable columns is
 * awkward (NULLs don't participate in the "=" comparison the constraint
 * needs). Effective-dated: never overwrite historical pricing — a new
 * tariff for the same (facilityId, chargeCode, payerId) gets a new row
 * with its own effectiveFrom, never an edit to an old one's dates.
 */
model Tariff {
  id              String    @id @default(cuid())
  facility        Facility  @relation(fields: [facilityId], references: [id])
  facilityId      String
  payer           Payer     @relation(fields: [payerId], references: [id])
  payerId         String
  chargeCode      String // LabTestCatalog.code / ImagingCatalog.code / "BED_DAY:<WardType>" / "PHARMACY:<DRUGNAME>" / "CONSULT_OPD" / package codes
  description     String
  category        String
  unitPriceMinor  Int
  currency        String    @default("INR")
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  active          Boolean   @default(true)
  createdByUserId String
  createdAt       DateTime  @default(now())

  @@index([facilityId, chargeCode, payerId])
}

/**
 * Package foundation only (brief's explicit "do not build a massive
 * package-management system") — applying a package creates exactly ONE
 * lump Charge (category "PACKAGE", sourceType "PackageApplication"); items
 * are display-only ("what's included" / "list-price reference for savings
 * display"), never separately billed, never matched against actual orders
 * placed.
 */
model PackageDefinition {
  id                String   @id @default(cuid())
  facility          Facility @relation(fields: [facilityId], references: [id])
  facilityId        String
  code              String
  name              String
  description       String?
  packagePriceMinor Int
  currency          String   @default("INR")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  items PackageItem[]

  @@unique([facilityId, code])
}

model PackageItem {
  id                String            @id @default(cuid())
  package           PackageDefinition @relation(fields: [packageId], references: [id])
  packageId         String
  chargeCode        String // informational reference only — NOT separately billed
  description       String
  quantity          Float             @default(1)
  refUnitPriceMinor Int // list-price reference, for "you saved ₹X" display only

  @@index([packageId])
}

/**
 * Per-facility, per-fiscal-year atomic counter backing Invoice/Claim
 * numbering (see sequence.ts#nextSequence). CAS-based (optimistic
 * concurrency retry loop), not a Postgres-only SERIAL/advisory lock — the
 * exact same mechanism works unmodified on SQLite dev.
 */
model InvoiceSequence {
  id         String   @id @default(cuid())
  facility   Facility @relation(fields: [facilityId], references: [id])
  facilityId String
  fiscalYear Int // calendar year — documented choice, not Apr-Mar
  nextValue  Int      @default(1)

  @@unique([facilityId, fiscalYear])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

/**
 * Immutable-once-ISSUED financial document. DRAFT is mutable (lines can be
 * added by pulling in un-invoiced POSTED charges for the account); ISSUED
 * freezes invoiceNumber + all four amount fields + every InvoiceLine.
 * Legal transitions: DRAFT -> ISSUED (guarded, assigns invoiceNumber via
 * InvoiceSequence CAS) -> {PARTIALLY_PAID, PAID} (driven by
 * PaymentAllocation sums) -> VOID (only from ISSUED/PARTIALLY_PAID with
 * ZERO allocated payments — otherwise correction is a FinancialAdjustment,
 * never a void of a paid invoice).
 */
model Invoice {
  id                String         @id @default(cuid())
  invoiceNumber     String?        @unique // null while DRAFT; assigned atomically at ISSUED
  billingAccount    BillingAccount @relation(fields: [billingAccountId], references: [id])
  billingAccountId  String
  encounter         Encounter      @relation(fields: [encounterId], references: [id])
  encounterId       String
  patient           Patient        @relation(fields: [patientId], references: [id])
  patientId         String
  facility          Facility       @relation(fields: [facilityId], references: [id])
  facilityId        String
  payer             Payer?         @relation(fields: [payerId], references: [id]) // null = self-pay
  payerId           String?
  status            InvoiceStatus  @default(DRAFT)
  subtotalMinor     Int            @default(0)
  discountMinor     Int            @default(0)
  taxMinor          Int            @default(0)
  totalMinor        Int            @default(0) // frozen at ISSUED
  allocatedMinor    Int            @default(0) // guarded running total, atomically maintained by allocatePayment — never exceeds totalMinor
  currency          String         @default("INR")
  issuedAt          DateTime?
  dueAt             DateTime?
  voidedAt          DateTime?
  voidedByUserId    String?
  voidReason        String?
  generatedByUserId String
  createdAt         DateTime       @default(now())

  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  adjustments FinancialAdjustment[]
  claim       Claim?

  @@index([billingAccountId])
  @@index([facilityId, status])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoice        Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId      String
  charge         Charge? @relation(fields: [chargeId], references: [id])
  chargeId       String? @unique // null only for an explicitly-authorized free-text line
  description    String
  quantity       Float   @default(1)
  unitPriceMinor Int
  netAmountMinor Int

  claimLine ClaimLine?

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NETBANKING
  CHEQUE
  INSURANCE_SETTLEMENT
}

enum PaymentStatus {
  RECEIVED
  VOIDED
}

/**
 * A received payment. Deposits/advances are simply Payment rows with zero
 * PaymentAllocation children — "money received with no invoice to apply it
 * to yet" IS what an unallocated payment already means, so there is no
 * separate Deposit model (would just duplicate this ledger). Idempotent on
 * idempotencyKey (the payment-race anchor — same client/gateway-generated
 * value on retry must never produce two postings). allocatedMinor/
 * refundedMinor are guarded running caches, CAS-updated in the SAME
 * transaction as the PaymentAllocation/Refund row they summarize (the
 * established "guarded updateMany" idiom used by every other stateful
 * entity in this codebase) — not a blind increment like the old
 * Bill.totalAmount. Invariant: allocatedMinor + refundedMinor <= amountMinor.
 */
model Payment {
  id               String         @id @default(cuid())
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id])
  billingAccountId String
  patient          Patient        @relation(fields: [patientId], references: [id])
  patientId        String
  facility         Facility       @relation(fields: [facilityId], references: [id])
  facilityId       String
  amountMinor      Int // immutable — total received
  allocatedMinor   Int            @default(0)
  refundedMinor    Int            @default(0)
  currency         String         @default("INR")
  method           PaymentMethod
  status           PaymentStatus  @default(RECEIVED)
  idempotencyKey   String         @unique
  referenceNo      String?
  receivedAt       DateTime       @default(now())
  receivedByUserId String
  voidedAt         DateTime?
  voidedByUserId   String?
  voidReason       String?

  allocations PaymentAllocation[]
  refunds     Refund[]

  @@index([billingAccountId])
  @@index([facilityId, receivedAt])
}

/**
 * Append-only — never edited or deleted. Correcting a mis-allocation means voiding the payment or issuing a FinancialAdjustment, never mutating an allocation row.
 */
model PaymentAllocation {
  id                String   @id @default(cuid())
  payment           Payment  @relation(fields: [paymentId], references: [id])
  paymentId         String
  invoice           Invoice  @relation(fields: [invoiceId], references: [id])
  invoiceId         String
  amountMinor       Int
  allocatedAt       DateTime @default(now())
  allocatedByUserId String

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

/**
 * References the original Payment — never mutates it. Maker-checker
 * enforced in service code (refunds.ts): approvedByUserId must differ from
 * requestedByUserId. Legal transitions: REQUESTED -> APPROVED -> COMPLETED,
 * or REQUESTED -> REJECTED. Immutable once COMPLETED.
 */
model Refund {
  id                String       @id @default(cuid())
  payment           Payment      @relation(fields: [paymentId], references: [id])
  paymentId         String
  amountMinor       Int
  reason            String
  status            RefundStatus @default(REQUESTED)
  requestedByUserId String
  approvedByUserId  String?
  completedAt       DateTime?
  idempotencyKey    String       @unique
  createdAt         DateTime     @default(now())

  @@index([paymentId])
}

enum AdjustmentType {
  CREDIT_NOTE
  DEBIT_NOTE
  WRITE_OFF
  DISCOUNT
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Correcting an issued invoice without mutating it. Once APPROVED,
 * immutable — a further correction is a NEW, opposite-direction
 * adjustment, never an edit (standard accounting discipline; avoids
 * "edit the ledger" recurring across this whole redesign).
 */
model FinancialAdjustment {
  id                String           @id @default(cuid())
  invoice           Invoice          @relation(fields: [invoiceId], references: [id])
  invoiceId         String
  type              AdjustmentType
  amountMinor       Int
  reason            String
  status            AdjustmentStatus @default(PENDING)
  requestedByUserId String
  approvedByUserId  String?
  createdAt         DateTime         @default(now())

  @@index([invoiceId])
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  SETTLED
  CLOSED
}

enum ClaimLineStatus {
  PENDING
  APPROVED
  DENIED
}

/**
 * One claim per invoice this phase (split-across-multiple-payers
 * explicitly deferred). No external payer/EDI integration — status is set
 * manually as staff record the payer's decision. Provenance to clinical
 * source needs no new table: ClaimLine.invoiceLineId -> InvoiceLine.chargeId
 * -> Charge.sourceType/sourceId -> the originating clinical order is
 * already a complete chain. Once SUBMITTED, immutable except via the
 * guarded status transitions below — a correction is a new claim, never a
 * silent rewrite.
 */
model Claim {
  id                   String            @id @default(cuid())
  invoice              Invoice           @relation(fields: [invoiceId], references: [id])
  invoiceId            String            @unique
  coverage             PatientCoverage   @relation(fields: [coverageId], references: [id])
  coverageId           String
  preAuthorization     PreAuthorization? @relation(fields: [preAuthorizationId], references: [id])
  preAuthorizationId   String?           @unique
  facility             Facility          @relation(fields: [facilityId], references: [id])
  facilityId           String
  claimNumber          String?           @unique // assigned at SUBMITTED, same InvoiceSequence mechanism
  status               ClaimStatus       @default(DRAFT)
  submittedAmountMinor Int
  approvedAmountMinor  Int?
  settledAmountMinor   Int?
  submittedAt          DateTime?
  decidedAt            DateTime?
  settledAt            DateTime?
  denialReason         String?
  externalReferenceNo  String? // payer's own claim ID — manual entry, no live API
  createdByUserId      String
  createdAt            DateTime          @default(now())

  lines ClaimLine[]

  @@index([facilityId, status])
}

model ClaimLine {
  id                  String          @id @default(cuid())
  claim               Claim           @relation(fields: [claimId], references: [id])
  claimId             String
  invoiceLine         InvoiceLine     @relation(fields: [invoiceLineId], references: [id])
  invoiceLineId       String          @unique
  claimedAmountMinor  Int
  approvedAmountMinor Int?
  status              ClaimLineStatus @default(PENDING)
  denialReason        String?

  @@index([claimId])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 1 — unified clinical core additions: Task, Document, Consent,
// Referral, PatientMergeRecord. See docs/CLINICAL_CORE.md.
// ─────────────────────────────────────────────────────────────────────────

/**
 * Generic task entity (brief §25 / docs/TARGET_DOMAIN_ARCHITECTURE.md
 * §2.3). Medication-due and vitals-due "tasks" remain computed views over
 * MedicationAdministration/Vital (deliberately — see
 * docs/CLINICAL_CORE.md §4, avoiding a duplicate source of truth for data
 * that already has a natural home table). This table is for every OTHER
 * task type, which has no natural home table of its own.
 */
model Task {
  id                 String                @id @default(cuid())
  facility           Facility              @relation(fields: [facilityId], references: [id])
  facilityId         String
  department         Department?           @relation(fields: [departmentId], references: [id])
  departmentId       String?
  title              String
  description        String?
  type               String // "DISCHARGE_PREP" | "PATIENT_EDUCATION" | "WOUND_CARE" | "FOLLOW_UP" | "GENERAL" | ...
  priority           String                @default("ROUTINE") // "ROUTINE" | "URGENT" | "STAT"
  status             String                @default("OPEN") // OPEN | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELLED | OVERDUE
  dueAt              DateTime?
  source             String? // what created this task, e.g. "manual" | "discharge-workflow"
  patient            Patient?              @relation(fields: [patientId], references: [id])
  patientId          String?
  encounterId        String?
  owner              HospitalStaffProfile? @relation("TaskOwner", fields: [ownerStaffId], references: [id])
  ownerStaffId       String?
  createdBy          HospitalStaffProfile  @relation("TaskCreatedBy", fields: [createdByStaffId], references: [id])
  createdByStaffId   String
  completedBy        HospitalStaffProfile? @relation("TaskCompletedBy", fields: [completedByStaffId], references: [id])
  completedByStaffId String?
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  // Phase 3 (brief §12) — deepens the existing engine without a new model.
  // A "nursing order" a doctor places is an Order (orderType=NURSING) whose
  // detail lives right here in Task, reusing the existing engine rather
  // than inventing a parallel NursingOrder table.
  order              Order?                @relation(fields: [orderId], references: [id])
  orderId            String?
  startedAt          DateTime?
  skippedAt          DateTime?
  skipReason         String?
  recurrenceRule     String? // free-text description ("every 4h") — no recurrence-generation engine built, see docs/PHASE_3_ARCHITECTURE.md §9

  // Phase 6.7 — optional back-link from a CarePlanIntervention that spawned
  // this task (brief §12). Nullable: most interventions never create a task.
  carePlanInterventions CarePlanIntervention[] @relation("InterventionTask")

  @@index([facilityId])
  @@index([status])
  @@index([orderId])
  @@index([ownerStaffId])
  @@index([patientId])
  @@index([facilityId, status])
}

/**
 * Document metadata foundation (brief §26) — deliberately metadata-only
 * this phase, no file-upload UI wired up (nothing in Hospital OS produces
 * real clinical documents yet). storageRef follows the same restricted-
 * storage pattern as Scholar's VerificationDocument when a real upload
 * path is built (src/lib/verification/provider.ts) — never inline bytes.
 */
model ClinicalDocument {
  id                String                @id @default(cuid())
  facility          Facility              @relation(fields: [facilityId], references: [id])
  facilityId        String
  patient           Patient               @relation(fields: [patientId], references: [id])
  patientId         String
  encounter         Encounter?            @relation(fields: [encounterId], references: [id])
  encounterId       String?
  type              String // "CONSENT_FORM" | "ID_PROOF" | "REPORT" | "REFERRAL_LETTER" | "OTHER"
  title             String
  storageRef        String? // nullable — metadata can exist before a file is actually attached
  version           Int                   @default(1)
  // Phase 6.9 — non-destructive versioning. A "new version" of a clinical
  // document supersedes the prior row (which is kept, marked SUPERSEDED)
  // rather than overwriting it, so finalized clinical documents are never
  // silently lost. Null for an original (v1) document.
  supersedesId      String?
  status            String                @default("CURRENT") // "CURRENT" | "SUPERSEDED"
  accessPolicy      String                @default("CLINICAL_STAFF") // "CLINICAL_STAFF" | "PATIENT_VISIBLE" | "RESTRICTED"
  author            HospitalStaffProfile? @relation("DocumentAuthor", fields: [authorStaffId], references: [id])
  authorStaffId     String?
  uploadedBy        HospitalStaffProfile  @relation("DocumentUploadedBy", fields: [uploadedByStaffId], references: [id])
  uploadedByStaffId String
  createdAt         DateTime              @default(now())

  @@index([patientId])
  @@index([facilityId])
}

/**
 * Consent as a first-class, non-boolean record (brief §27). Not yet wired
 * to gate any real workflow this phase (no current route checks consent
 * before proceeding) — the foundation is built honestly ahead of the
 * workflow that will enforce it, matching this repository's established
 * "architecture before enforcement, never enforcement theater" pattern.
 */
model Consent {
  id           String                @id @default(cuid())
  patient      Patient               @relation(fields: [patientId], references: [id])
  patientId    String
  purpose      String // e.g. "TREATMENT" | "DATA_SHARING" | "RESEARCH" | "PROCEDURE"
  scope        String?
  status       String                @default("REQUESTED") // REQUESTED | GRANTED | DENIED | REVOKED | EXPIRED
  version      Int                   @default(1)
  grantedAt    DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime?
  actor        HospitalStaffProfile? @relation(fields: [actorStaffId], references: [id])
  actorStaffId String?
  createdAt    DateTime              @default(now())

  @@index([patientId])
}

/**
 * Referral (brief §22/§161) — uses the target generalized order lifecycle
 * (DRAFT/PLACED/ACKNOWLEDGED/IN_PROGRESS/COMPLETED/CANCELLED/REJECTED)
 * since this is a brand-new entity with no existing working code to break
 * by adopting it. Existing order types (MedicationOrder/LabOrder/
 * ImagingOrder) keep their own established status strings rather than
 * being renamed onto this vocabulary — see docs/CLINICAL_CORE.md §5 for
 * the mapping and the reasoning.
 */
model Referral {
  id               String                @id @default(cuid())
  patient          Patient               @relation(fields: [patientId], references: [id])
  patientId        String
  encounter        Encounter             @relation(fields: [encounterId], references: [id])
  encounterId      String
  fromDepartment   Department?           @relation("ReferralFromDept", fields: [fromDepartmentId], references: [id])
  fromDepartmentId String?
  toDepartment     Department?           @relation("ReferralToDept", fields: [toDepartmentId], references: [id])
  toDepartmentId   String?
  fromStaff        HospitalStaffProfile  @relation("ReferralFromStaff", fields: [fromStaffId], references: [id])
  fromStaffId      String
  toStaff          HospitalStaffProfile? @relation("ReferralToStaff", fields: [toStaffId], references: [id])
  toStaffId        String?
  reason           String
  priority         String                @default("ROUTINE") // ROUTINE | URGENT | STAT
  status           String                @default("PLACED") // DRAFT | PLACED | ACKNOWLEDGED | IN_PROGRESS | COMPLETED | CANCELLED | REJECTED
  notes            String?
  createdAt        DateTime              @default(now())
  respondedAt      DateTime? // terminal-state timestamp (COMPLETED/REJECTED/CANCELLED) — unchanged from Phase 1
  // Phase 3 (brief §8): distinguishes "accepted, now being worked" from "closed" — respondedAt alone couldn't.
  acceptedAt       DateTime?
  order            Order?                @relation(fields: [orderId], references: [id])
  orderId          String?               @unique

  @@index([patientId])
  @@index([encounterId])
  @@index([status])
}

/**
 * Audit record of a logical patient merge (brief §10). The merge itself
 * never deletes data — see Patient.mergedIntoId/mergedFrom above and
 * src/lib/patient/merge.ts for how a merged patient's history is included
 * when the target is read.
 */
model PatientMergeRecord {
  id              String               @id @default(cuid())
  sourcePatient   Patient              @relation("MergeSource", fields: [sourcePatientId], references: [id])
  sourcePatientId String
  targetPatient   Patient              @relation("MergeTarget", fields: [targetPatientId], references: [id])
  targetPatientId String
  actor           HospitalStaffProfile @relation(fields: [actorStaffId], references: [id])
  actorStaffId    String
  reason          String
  createdAt       DateTime             @default(now())

  @@index([sourcePatientId])
  @@index([targetPatientId])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 2 — Patient Flow + Access + OPD + Emergency + ADT
// (Admission/Transfer/Discharge requests, queueing, triage, scheduling).
// See docs/PATIENT_FLOW.md and docs/ADT_ARCHITECTURE.md. Deliberately does
// NOT touch Bed/Admission/Transfer/Discharge/BedStateEvent's core shape —
// this phase adds a request/reservation layer ON TOP of that existing,
// working, transactional machinery (src/lib/hospital/{bed,admission}.ts),
// per the explicit "do not duplicate existing admission/bed logic"
// instruction. Existing EncounterStatus/BedStatus enums are reused as-is.
// ─────────────────────────────────────────────────────────────────────────

enum AppointmentType {
  NEW
  FOLLOW_UP
  PROCEDURE
  REVIEW
  TELEMEDICINE
  EMERGENCY_OVERRIDE
}

/**
 * How the patient reached this appointment/encounter — brief §6/§17/§45-47.
 */
enum AccessSource {
  APPOINTMENT
  WALK_IN
  REFERRAL
  EMERGENCY
  FOLLOW_UP
  AMBULANCE
}

/**
 * Shared priority vocabulary for admission/transfer requests (brief §28/§34) — deliberately NOT a clinical acuity scale (see TriageAssessment.acuity for that).
 */
enum RequestPriority {
  ROUTINE
  URGENT
  EMERGENCY
}

model Appointment {
  id                 String               @id @default(cuid())
  facility           Facility             @relation(fields: [facilityId], references: [id])
  facilityId         String
  department         Department?          @relation(fields: [departmentId], references: [id])
  departmentId       String?
  doctor             HospitalStaffProfile @relation("AppointmentDoctor", fields: [doctorStaffId], references: [id])
  doctorStaffId      String
  patient            Patient              @relation(fields: [patientId], references: [id])
  patientId          String
  type               AppointmentType      @default(NEW)
  source             AccessSource         @default(APPOINTMENT)
  priority           RequestPriority      @default(ROUTINE)
  roomLabel          String?
  scheduledStart     DateTime
  scheduledEnd       DateTime
  reason             String?
  status             String               @default("REQUESTED") // REQUESTED|CONFIRMED|RESCHEDULED|ARRIVED|CHECKED_IN|WAITING|IN_CONSULTATION|COMPLETED|CANCELLED|NO_SHOW
  encounter          Encounter?           @relation(fields: [encounterId], references: [id])
  encounterId        String?
  cancelledReason    String?
  cancelledAt        DateTime?
  cancelledByStaffId String?
  noShowAt           DateTime?
  createdByStaffId   String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  queueEntries QueueEntry[]

  @@index([facilityId])
  @@index([doctorStaffId, scheduledStart])
  @@index([status])
  @@index([patientId])
}

/**
 * Doctor scheduling foundation (brief §7) — working hours, sessions,
 * leave/holiday/blocked periods, only. No payroll/HR. A recurring session
 * is `dayOfWeek` + `startMinute`/`endMinute` (minutes from midnight, since
 * SQLite has no TIME type); a one-off leave/holiday/block uses
 * `specificDate` instead, which takes precedence over any recurring
 * session that day when computing available slots.
 */
model DoctorScheduleBlock {
  id                        String               @id @default(cuid())
  staff                     HospitalStaffProfile @relation(fields: [staffId], references: [id])
  staffId                   String
  facility                  Facility             @relation(fields: [facilityId], references: [id])
  facilityId                String
  department                Department?          @relation(fields: [departmentId], references: [id])
  departmentId              String?
  type                      String // "CLINIC_SESSION" | "BLOCKED" | "LEAVE" | "HOLIDAY"
  dayOfWeek                 Int? // 0 (Sun) - 6 (Sat); null when specificDate is a one-off override
  specificDate              DateTime? // date-only one-off (leave/holiday/single block); time part ignored
  startMinute               Int? // minutes from midnight; null for a whole-day LEAVE/HOLIDAY
  endMinute                 Int?
  slotDurationMinutes       Int?                 @default(15) // only meaningful for CLINIC_SESSION
  maxConcurrentAppointments Int                  @default(1) // overbooking policy — 1 = no overbooking
  roomLabel                 String?
  reason                    String? // for BLOCKED/LEAVE
  createdAt                 DateTime             @default(now())

  @@index([staffId])
  @@index([facilityId])
}

/**
 * Generalized, database-backed patient queue (brief §8) — every waiting
 * line (front-desk registration, triage, a doctor's OPD queue, the ED
 * board) is a `queueType` on this one table rather than a bespoke table
 * per queue. `priorityScore` is written by the priority-rules engine
 * (src/lib/hospital/queue.ts, brief §9) — lower sorts first — and is
 * recomputed, not silently reordered, whenever a triage/priority change
 * happens (see `priorityReason`).
 */
model QueueEntry {
  id                  String                @id @default(cuid())
  facility            Facility              @relation(fields: [facilityId], references: [id])
  facilityId          String
  department          Department?           @relation(fields: [departmentId], references: [id])
  departmentId        String?
  queueType           String // "REGISTRATION" | "TRIAGE" | "OPD_DOCTOR" | "ED"
  patient             Patient               @relation(fields: [patientId], references: [id])
  patientId           String
  encounter           Encounter?            @relation(fields: [encounterId], references: [id])
  encounterId         String?
  appointment         Appointment?          @relation(fields: [appointmentId], references: [id])
  appointmentId       String?
  practitioner        HospitalStaffProfile? @relation("QueuePractitioner", fields: [practitionerStaffId], references: [id])
  practitionerStaffId String?
  priorityScore       Int                   @default(100) // lower = seen sooner
  priorityReason      String?
  status              String                @default("WAITING") // WAITING | CALLED | IN_SERVICE | COMPLETED | SKIPPED | CANCELLED
  enteredAt           DateTime              @default(now())
  calledAt            DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  createdByStaffId    String?

  @@index([facilityId])
  @@index([queueType])
  @@index([status])
  @@index([patientId])
}

/**
 * A recorded triage assessment (brief §19-20) — the clinician/nurse
 * records the acuity; the software never determines it autonomously.
 * Distinct from `Encounter.triageLevel` (a denormalized "current" cache
 * updated alongside this, so existing ED-list/order-triggering code that
 * already reads `Encounter.triageLevel` keeps working unchanged) — this
 * table is the full auditable record: who, when, red flags, and the area
 * assigned as a result.
 */
model TriageAssessment {
  id                String               @id @default(cuid())
  encounter         Encounter            @relation(fields: [encounterId], references: [id])
  encounterId       String
  facility          Facility             @relation(fields: [facilityId], references: [id])
  facilityId        String
  recordedBy        HospitalStaffProfile @relation(fields: [recordedByStaffId], references: [id])
  recordedByStaffId String
  acuity            Int // 1 (resuscitation) - 5 (non-urgent) — configurable scale, not an AI decision
  chiefComplaint    String?
  redFlags          String?
  assignedArea      String? // "RESUSCITATION" | "HIGH_PRIORITY" | "STANDARD" | "OBSERVATION"
  notes             String?
  createdAt         DateTime             @default(now())

  // Phase B5 — ED triage lifecycle + documentary fields (all additive; the
  // Phase 2 flow keeps working since status defaults to COMPLETED). Acuity is
  // still a clinician-entered value — no ESI/severity algorithm is applied.
  // `amends` links an amendment to the assessment it corrects (provenance);
  // history is never overwritten, an amendment is always a new row.
  status             String             @default("COMPLETED") // "DRAFT" | "COMPLETED" | "AMENDED"
  amends             TriageAssessment?  @relation("TriageAmendment", fields: [amendsId], references: [id])
  amendsId           String?
  amendedBy          TriageAssessment[] @relation("TriageAmendment")
  presentingSymptoms String?
  allergySummary     String? // documentary reference — canonical Allergy remains the source of truth
  currentMedications String?
  relevantHistory    String?
  painScore          Int? // 0-10 as recorded, never interpreted
  mentalStatus       String? // documentary (e.g. "ALERT" | "DROWSY" | ...) — not a computed GCS
  mobility           String?
  pregnancyStatus    String?
  isolationRequired  Boolean            @default(false)
  injuryTrauma       Boolean            @default(false)

  @@index([encounterId])
  @@index([facilityId])
}

/**
 * Where a patient physically is right now, independent of clinical
 * encounter status (brief §22/§33/§54) — reuses `Bed` when the location
 * IS a real bed resource (an ED bay is a `Bed` row in an EMERGENCY ward,
 * same as an inpatient bed), and falls back to a free-text `areaLabel`
 * for genuinely non-bed/temporary locations ("CT", "Waiting Area").
 * Latest row with `releasedAt: null` for an encounter is its current
 * location. Deliberately lighter-weight than `Admission` — an ED patient
 * is not admitted, so this does not touch `Bed.status`/occupancy.
 */
model EncounterLocation {
  id                String    @id @default(cuid())
  encounter         Encounter @relation(fields: [encounterId], references: [id])
  encounterId       String
  facility          Facility  @relation(fields: [facilityId], references: [id])
  facilityId        String
  bed               Bed?      @relation(fields: [bedId], references: [id])
  bedId             String?
  areaLabel         String?
  assignedByStaffId String?
  assignedAt        DateTime  @default(now())
  releasedAt        DateTime?

  @@index([encounterId])
  @@index([bedId])
}

/**
 * A request to admit a patient — does NOT itself touch `Bed`/`Admission`
 * (brief §28: "do not directly mutate the bed simply because a doctor
 * clicked admit"). `reservedBedId` is populated by the bed-matching +
 * reservation step (src/lib/hospital/admissionRequest.ts), which flips
 * the bed to `RESERVED` via the EXISTING `transitionBed()` service — not
 * a new bed state machine. Confirming admission calls the EXISTING
 * `admitPatient()` (relaxed to also accept a bed this request itself
 * reserved) — not a new admission path.
 */
model AdmissionRequest {
  id                 String                @id @default(cuid())
  patient            Patient               @relation(fields: [patientId], references: [id])
  patientId          String
  encounter          Encounter             @relation(fields: [encounterId], references: [id])
  encounterId        String
  facility           Facility              @relation(fields: [facilityId], references: [id])
  facilityId         String
  department         Department?           @relation(fields: [departmentId], references: [id])
  departmentId       String?
  requestedBy        HospitalStaffProfile  @relation("AdmissionRequestedBy", fields: [requestedByStaffId], references: [id])
  requestedByStaffId String
  requestedWardType  WardType?
  isolationRequired  Boolean               @default(false)
  genderRestriction  String?
  priority           RequestPriority       @default(ROUTINE)
  reason             String
  expectedLosDays    Int?
  status             String                @default("PENDING") // PENDING | DEFERRED | BED_RESERVED | ADMITTED | REJECTED | CANCELLED
  reviewedBy         HospitalStaffProfile? @relation("AdmissionReviewedBy", fields: [reviewedByStaffId], references: [id])
  reviewedByStaffId  String?
  reviewedAt         DateTime?
  rejectionReason    String?
  reservedBed        Bed?                  @relation(fields: [reservedBedId], references: [id])
  reservedBedId      String?
  admission          Admission?            @relation(fields: [admissionId], references: [id])
  admissionId        String?               @unique
  createdAt          DateTime              @default(now())

  @@index([facilityId])
  @@index([status])
  @@index([encounterId])
}

/**
 * A request to move an admitted patient to a different bed (brief §34) —
 * layered on the existing `Admission`/`Transfer` models, not a
 * replacement. Completing a request calls the EXISTING `transferPatient()`
 * (relaxed to accept a bed this request itself reserved), which creates
 * the real `Transfer` row this request then links to.
 */
model TransferRequest {
  id                       String                @id @default(cuid())
  admission                Admission             @relation(fields: [admissionId], references: [id])
  admissionId              String
  facility                 Facility              @relation(fields: [facilityId], references: [id])
  facilityId               String
  patient                  Patient               @relation(fields: [patientId], references: [id])
  patientId                String
  requestedBy              HospitalStaffProfile  @relation("TransferRequestedBy", fields: [requestedByStaffId], references: [id])
  requestedByStaffId       String
  reason                   String
  destinationWardType      WardType?
  isolationRequired        Boolean               @default(false)
  genderRestriction        String?
  priority                 RequestPriority       @default(ROUTINE)
  transportRequired        Boolean               @default(false)
  clinicalHandoverRequired Boolean               @default(true)
  status                   String                @default("REQUESTED") // REQUESTED | ACCEPTED | BED_RESERVED | PATIENT_IN_TRANSIT | COMPLETED | CANCELLED | REJECTED
  acceptedBy               HospitalStaffProfile? @relation("TransferAcceptedBy", fields: [acceptedByStaffId], references: [id])
  acceptedByStaffId        String?
  reservedBed              Bed?                  @relation(fields: [reservedBedId], references: [id])
  reservedBedId            String?
  transfer                 Transfer?             @relation(fields: [transferId], references: [id])
  transferId               String?               @unique
  createdAt                DateTime              @default(now())
  completedAt              DateTime?

  @@index([facilityId])
  @@index([status])
  @@index([admissionId])
}

/**
 * Configurable operational SLA thresholds (brief §52) — hospital
 * operational configuration, explicitly NOT a hard-coded clinical
 * standard. Read by the alert engine (src/lib/hospital/alertEngine.ts)
 * instead of the fixed constants it used before this phase.
 */
model SlaPolicy {
  id               String   @id @default(cuid())
  facility         Facility @relation(fields: [facilityId], references: [id])
  facilityId       String
  metric           String // "REGISTRATION_WAIT" | "ED_DOCTOR_WAIT" | "ADMISSION_ALLOCATION" | "TRANSFER" | "DISCHARGE_READY"
  thresholdMinutes Int
  updatedAt        DateTime @updatedAt

  @@unique([facilityId, metric])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase B1 — ICU Foundation. Additive on top of the existing Facility/
// Ward/Bed/Encounter/ADT/Vital/MAR/Task/Note/Handoff machinery — no parallel
// patient/encounter/bed/medication/nursing system. ICU observations are
// documentary records (recording + provenance), never automated clinical
// interpretation or scoring. See docs (Phase B1). recordedByStaffId is a
// plain string, matching the existing Vital/IntakeOutputRecord convention.
// ─────────────────────────────────────────────────────────────────────────

/**
 * ICU unit type — extensible; free-string not used since these are a small closed operational set.
 */
enum IcuType {
  MICU
  SICU
  CCU
  NICU
  PICU
  HDU
  GENERAL_ICU
}

model IcuUnit {
  id                String   @id @default(cuid())
  facility          Facility @relation(fields: [facilityId], references: [id])
  facilityId        String
  departmentId      String?
  name              String
  icuType           IcuType  @default(GENERAL_ICU)
  active            Boolean  @default(true)
  ventilatorCapable Boolean  @default(false)
  isolationCapable  Boolean  @default(false)
  bedCapacity       Int? // configured capacity — informational, not enforced
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  beds Bed[]

  @@unique([facilityId, name])
  @@index([facilityId])
}

/**
 * A single ICU flowsheet observation. `type` selects the shape of `values`
 * (a documentary JSON blob, same pattern as NursingAssessment.findings /
 * ClinicalNote.content): "VENTILATOR" | "NEURO" | "ABG". Vital signs use the
 * existing Vital model (not duplicated here); I/O uses IntakeOutputRecord.
 * No interpretation/scoring is computed — values are recorded as entered.
 */
model IcuObservation {
  id                String    @id @default(cuid())
  facility          Facility  @relation(fields: [facilityId], references: [id])
  facilityId        String
  patient           Patient   @relation(fields: [patientId], references: [id])
  patientId         String
  encounter         Encounter @relation(fields: [encounterId], references: [id])
  encounterId       String
  type              String // "VENTILATOR" | "NEURO" | "ABG"
  values            Json
  recordedByStaffId String
  recordedAt        DateTime  @default(now())

  @@index([encounterId, type])
  @@index([facilityId])
  @@index([patientId])
}

/**
 * ICU device/line association with a coherent lifecycle
 * (PLANNED -> ACTIVE -> REMOVED/DISCONTINUED). Records only — no biomedical
 * integration or telemetry. `deviceType`/`site` are free strings; no clinical
 * complication taxonomy is invented (notes are free text).
 */
model IcuDevice {
  id                String    @id @default(cuid())
  facility          Facility  @relation(fields: [facilityId], references: [id])
  facilityId        String
  patient           Patient   @relation(fields: [patientId], references: [id])
  patientId         String
  encounter         Encounter @relation(fields: [encounterId], references: [id])
  encounterId       String
  deviceType        String // "CENTRAL_LINE" | "ARTERIAL_LINE" | "URINARY_CATHETER" | "DRAIN" | "ETT" | "TRACHEOSTOMY" | ...
  site              String?
  status            String    @default("PLANNED") // "PLANNED" | "ACTIVE" | "REMOVED" | "DISCONTINUED"
  insertedAt        DateTime?
  removedAt         DateTime?
  notes             String?
  recordedByStaffId String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([encounterId])
  @@index([facilityId])
  @@index([patientId])
  @@index([status])
}

/**
 * ICU infusion tracking. References the canonical MedicationOrder where one
 * exists (this is NOT a second MAR — the order stays authoritative); it
 * records the running infusion's rate/concentration/lifecycle over time. No
 * dosing recommendation logic.
 */
model IcuInfusion {
  id                String    @id @default(cuid())
  facility          Facility  @relation(fields: [facilityId], references: [id])
  facilityId        String
  patient           Patient   @relation(fields: [patientId], references: [id])
  patientId         String
  encounter         Encounter @relation(fields: [encounterId], references: [id])
  encounterId       String
  medicationOrderId String? // canonical order, when the infusion is order-backed
  drugName          String
  route             String?
  concentration     String?
  rate              Float?
  rateUnit          String? // e.g. "mL/hr", "mcg/kg/min" — recorded as entered
  status            String    @default("RUNNING") // "RUNNING" | "PAUSED" | "STOPPED"
  startedAt         DateTime  @default(now())
  stoppedAt         DateTime?
  prescriberStaffId String?
  recordedByStaffId String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([encounterId])
  @@index([facilityId])
  @@index([patientId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase B3 — Operating Theatre & Surgical Workflow. Additive; composes the
// existing Patient/Encounter/ADT/ClinicalNote/Item-ItemLot-stock/Charge
// systems — no parallel patient/encounter/bed/medication/inventory/note.
// Specimen/implant patient/encounter/facility are DERIVED from the parent
// Surgery server-side (never client-supplied), making wrong-patient
// attachment structurally impossible. staffId fields are plain strings,
// matching the Vital/IcuObservation convention. No clinical scoring/
// dosing/decision logic — recording + workflow + provenance only.
// ─────────────────────────────────────────────────────────────────────────

enum SurgeryStatus {
  REQUESTED
  REVIEWED
  APPROVED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AnesthesiaType {
  GENERAL
  REGIONAL
  LOCAL
  SEDATION
  OTHER
}

/**
 * Configurable procedure catalog (not a hardcoded taxonomy).
 */
model Procedure {
  id                     String   @id @default(cuid())
  facility               Facility @relation(fields: [facilityId], references: [id])
  facilityId             String
  code                   String
  name                   String
  description            String?
  specialty              String?
  typicalDurationMinutes Int?
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  surgeries Surgery[]

  @@unique([facilityId, code])
  @@index([facilityId])
}

/**
 * Operating theatre configuration + explicitly-declared capabilities (resource matching only, no clinical inference).
 */
model OperatingTheatre {
  id           String   @id @default(cuid())
  facility     Facility @relation(fields: [facilityId], references: [id])
  facilityId   String
  departmentId String?
  name         String
  type         String? // "GENERAL" | "ORTHOPEDIC" | "CARDIAC" | "NEURO" | "OBSTETRIC" | ... (free-string, extensible)
  active       Boolean  @default(true)
  capabilities Json? // explicitly-configured capability tags, e.g. { imaging: true, laminarFlow: true }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schedules SurgerySchedule[]

  @@unique([facilityId, name])
  @@index([facilityId])
}

model Surgery {
  id                 String        @id @default(cuid())
  facility           Facility      @relation(fields: [facilityId], references: [id])
  facilityId         String
  patient            Patient       @relation(fields: [patientId], references: [id])
  patientId          String
  encounter          Encounter     @relation(fields: [encounterId], references: [id])
  encounterId        String
  procedure          Procedure?    @relation(fields: [procedureId], references: [id])
  procedureId        String?
  procedureName      String // denormalized at request time so history is stable even if the catalog entry changes
  indication         String?
  laterality         String? // "LEFT" | "RIGHT" | "BILATERAL" | "NA"
  urgency            String        @default("ELECTIVE") // "ELECTIVE" | "URGENT" | "EMERGENCY"
  status             SurgeryStatus @default(REQUESTED)
  requestedByStaffId String
  requestedDate      DateTime?
  reviewedByStaffId  String?
  reviewedAt         DateTime?
  approvedByStaffId  String?
  approvedAt         DateTime?
  cancelledReason    String?
  cancelledAt        DateTime?

  // Pre-op workflow (documentation, not a medical-fitness determination).
  consentStatus     String? // "PENDING" | "OBTAINED" | "REFUSED" | "NA"
  consentAt         DateTime?
  consentByStaffId  String?
  consentDocumentId String?
  preOpReady        Boolean   @default(false)
  preOpNotes        String?

  // Procedure execution.
  actualStart          DateTime?
  actualEnd            DateTime?
  surgeonStaffId       String?
  operativeFindings    String?
  operativeDetails     String?
  complications        String?
  estimatedBloodLossMl Int?
  recoveryDestination  String? // "PACU" | "ICU" | "WARD"
  operativeNoteId      String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedule   SurgerySchedule?
  team       SurgeryTeamMember[]
  checklist  SurgeryChecklistItem[]
  anesthesia AnesthesiaRecord?
  specimens  SurgicalSpecimen[]
  itemUsages SurgeryItemUsage[]
  recovery   RecoveryRecord?

  @@index([facilityId])
  @@index([patientId])
  @@index([encounterId])
  @@index([status])
}

/**
 * OT time slot for a surgery. Overlap prevention: an app-level check gives a
 * clean error, and a Postgres EXCLUDE constraint (surgery_schedule_no_overlap,
 * hand-written in the postgres baseline like imaging_resource_no_overlap) is
 * the actual race-proof guarantee. surgeryId is unique (a surgery is
 * scheduled at most once at a time).
 */
model SurgerySchedule {
  id                 String           @id @default(cuid())
  surgery            Surgery          @relation(fields: [surgeryId], references: [id])
  surgeryId          String           @unique
  operatingTheatre   OperatingTheatre @relation(fields: [operatingTheatreId], references: [id])
  operatingTheatreId String
  facilityId         String
  startAt            DateTime
  endAt              DateTime
  status             String           @default("SCHEDULED") // "SCHEDULED" | "CANCELLED"
  schedulerStaffId   String
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([operatingTheatreId, startAt])
  @@index([facilityId])
}

model SurgeryTeamMember {
  id        String   @id @default(cuid())
  surgery   Surgery  @relation(fields: [surgeryId], references: [id])
  surgeryId String
  staffId   String
  role      String // "SURGEON" | "ASSISTANT_SURGEON" | "ANESTHETIST" | "ANESTHETIST_ASSISTANT" | "SCRUB_NURSE" | "CIRCULATING_NURSE" | "TECHNICIAN"
  createdAt DateTime @default(now())

  @@unique([surgeryId, staffId, role])
  @@index([surgeryId])
}

/**
 * WHO-style surgical safety checklist items, grouped by phase. Configurable label set seeded per surgery on demand.
 */
model SurgeryChecklistItem {
  id               String    @id @default(cuid())
  surgery          Surgery   @relation(fields: [surgeryId], references: [id])
  surgeryId        String
  phase            String // "BEFORE_INDUCTION" | "BEFORE_INCISION" | "BEFORE_LEAVING"
  itemKey          String
  label            String
  checked          Boolean   @default(false)
  checkedByStaffId String?
  checkedAt        DateTime?

  @@unique([surgeryId, itemKey])
  @@index([surgeryId, phase])
}

model AnesthesiaRecord {
  id                  String         @id @default(cuid())
  surgery             Surgery        @relation(fields: [surgeryId], references: [id])
  surgeryId           String         @unique
  type                AnesthesiaType
  anesthetistStaffId  String
  status              String         @default("PLANNED") // "PLANNED" | "IN_PROGRESS" | "COMPLETED"
  startAt             DateTime?
  endAt               DateTime?
  preAssessmentNoteId String?
  intraOpNotes        String?
  complications       String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

/**
 * Surgical specimen collection record (feeds the pathology/lab workflow —
 * NOT a parallel lab). patient/encounter/facility are copied from the parent
 * Surgery, never client-supplied.
 */
model SurgicalSpecimen {
  id                 String   @id @default(cuid())
  surgery            Surgery  @relation(fields: [surgeryId], references: [id])
  surgeryId          String
  facilityId         String
  patientId          String
  encounterId        String
  specimenType       String
  site               String?
  label              String?
  destinationLab     String?
  status             String   @default("COLLECTED") // "COLLECTED" | "SENT" | "RECEIVED"
  collectedByStaffId String
  collectedAt        DateTime @default(now())
  notes              String?

  @@index([surgeryId])
  @@index([patientId])
}

/**
 * Surgical implant OR consumable usage. References canonical Item/ItemLot by
 * id (validated via the inventory facility-scope helpers + issueStock, which
 * performs the actual transactional, over-issue-safe consumption). Not a
 * second stock ledger.
 */
model SurgeryItemUsage {
  id                String    @id @default(cuid())
  surgery           Surgery   @relation(fields: [surgeryId], references: [id])
  surgeryId         String
  facilityId        String
  patientId         String
  encounterId       String
  usageType         String // "IMPLANT" | "CONSUMABLE"
  itemId            String
  itemLotId         String?
  manufacturer      String?
  serialNumber      String?
  site              String?
  quantity          Float
  stockConsumed     Boolean   @default(false)
  implantedAt       DateTime?
  recordedByStaffId String
  createdAt         DateTime  @default(now())

  @@index([surgeryId])
  @@index([patientId])
  @@index([itemId])
}

model RecoveryRecord {
  id                 String    @id @default(cuid())
  surgery            Surgery   @relation(fields: [surgeryId], references: [id])
  surgeryId          String    @unique
  destination        String? // "PACU" | "ICU" | "WARD"
  status             String    @default("PENDING") // "PENDING" | "IN_RECOVERY" | "READY_FOR_TRANSFER" | "TRANSFERRED"
  arrivalAt          DateTime?
  departureAt        DateTime?
  responsibleStaffId String?
  nurseStaffId       String?
  handoffId          String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 3 — Doctor OS + Nursing OS + Medication Lifecycle + Pharmacy
// See docs/PHASE_3_ARCHITECTURE.md §1 for the generalized-Order decision
// this section resolves: an ADDITIVE polymorphic envelope, never a
// destructive rewrite of the existing, working MedicationOrder/LabOrder/
// ImagingOrder/Referral tables. MedicationOrder's status was upgraded from
// a loose string to a real enum this phase; LabOrder/ImagingOrder followed
// in Phase 4 Milestone A (see the enum block near MedicationOrderStatus)
// once their Order-envelope link was actually wired up — until then their
// status stayed free-text by deliberate choice.
// ─────────────────────────────────────────────────────────────────────────

enum OrderType {
  MEDICATION
  LAB
  IMAGING
  NURSING
  REFERRAL
  PROCEDURE // declared for extensibility (brief §1) — zero rows this phase, see docs/PHASE_3_ARCHITECTURE.md §9
  BLOOD // declared for extensibility — zero rows this phase, no Blood Bank module built (brief §47 non-goal)
  DIETARY // declared for extensibility — zero rows this phase
}

/**
 * Coarse, cross-cutting order status — NOT a replacement for a type's own detailed status (e.g. MedicationOrderStatus below), which remains the source of truth for that type's workflow. This is what lets one query answer "every active order for this patient, any type."
 */
enum OrderStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  DISCONTINUED
}

model Order {
  id              String               @id @default(cuid())
  facility        Facility             @relation(fields: [facilityId], references: [id])
  facilityId      String
  encounter       Encounter            @relation(fields: [encounterId], references: [id])
  encounterId     String
  patient         Patient              @relation(fields: [patientId], references: [id])
  patientId       String
  orderingStaff   HospitalStaffProfile @relation(fields: [orderingStaffId], references: [id])
  orderingStaffId String
  orderType       OrderType
  status          OrderStatus          @default(ACTIVE)
  priority        RequestPriority      @default(ROUTINE)
  indication      String?
  notes           String?
  startAt         DateTime?
  discontinueAt   DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime             @default(now())

  medicationOrder MedicationOrder?
  labOrder        LabOrder?
  imagingOrder    ImagingOrder?
  referral        Referral?
  nursingTasks    Task[]

  @@index([facilityId])
  @@index([encounterId])
  @@index([patientId])
  @@index([status])
  @@index([orderType])
}

/**
 * Care plan (brief §6) — problem/goal/interventions, distinct from the
 * Phase 1 `Problem` (persistent problem-list entry, no goal/intervention
 * structure) and from `Task` (a single actionable item, no goal). Does
 * not invent thresholds or protocols — `targetDate`/`priority` only;
 * clinical parameters referenced in `goal`/interventions' `description`
 * are free text a clinician writes, never computed by this system.
 */
enum CarePlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model CarePlan {
  id               String          @id @default(cuid())
  patient          Patient         @relation(fields: [patientId], references: [id])
  patientId        String
  encounter        Encounter?      @relation(fields: [encounterId], references: [id])
  encounterId      String?
  facility         Facility        @relation(fields: [facilityId], references: [id])
  facilityId       String
  problem          String
  goal             String
  status           CarePlanStatus  @default(ACTIVE)
  priority         RequestPriority @default(ROUTINE)
  targetDate       DateTime?
  createdByStaffId String
  createdAt        DateTime        @default(now())
  completedAt      DateTime?
  notes            String?

  interventions CarePlanIntervention[]

  @@index([patientId])
  @@index([facilityId])
  @@index([status])
}

enum InterventionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model CarePlanIntervention {
  id              String             @id @default(cuid())
  carePlan        CarePlan           @relation(fields: [carePlanId], references: [id])
  carePlanId      String
  description     String
  responsibleRole String // free-text role label ("Nursing", "Respiratory Therapy") — same convention as Task.type, not a closed set
  status          InterventionStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  completedAt     DateTime?

  // Phase 6.7 (brief §12) — optional link to the Task engine so an
  // intervention can be tracked/completed through the existing Task
  // workflow rather than a second parallel workflow system. Nullable:
  // most interventions are documentary only and never spawn a task.
  task   Task?   @relation("InterventionTask", fields: [taskId], references: [id])
  taskId String?

  @@index([carePlanId])
  @@index([taskId])
}

/**
 * Nursing assessment (Phase 6.7 §6) — versioned clinical documentation for
 * nurses, mirroring ClinicalNote's sign/amend shape rather than inventing a
 * parallel pattern. Lifecycle: DRAFT -> COMPLETED -> SIGNED -> SUPERSEDED.
 * An amendment supersedes the prior SIGNED/isCurrent row and becomes the
 * new SIGNED/isCurrent row in one step (same shape as ClinicalNote's
 * amend). `findings` is a documentary JSON blob (system-review style
 * sections) — no invented scoring system or clinical decision logic.
 */
model NursingAssessment {
  id                String               @id @default(cuid())
  facility          Facility             @relation(fields: [facilityId], references: [id])
  facilityId        String
  patient           Patient              @relation(fields: [patientId], references: [id])
  patientId         String
  encounter         Encounter            @relation(fields: [encounterId], references: [id])
  encounterId       String
  nurse             HospitalStaffProfile @relation("NursingAssessmentNurse", fields: [nurseStaffId], references: [id])
  nurseStaffId      String
  status            String               @default("DRAFT") // "DRAFT" | "COMPLETED" | "SIGNED" | "SUPERSEDED"
  version           Int                  @default(1)
  isCurrent         Boolean              @default(true)
  previousVersionId String?
  findings          Json
  completedAt       DateTime?
  signedAt          DateTime?
  amendedAt         DateTime?
  amendmentReason   String?
  createdAt         DateTime             @default(now())

  @@index([facilityId])
  @@index([patientId])
  @@index([encounterId, isCurrent])
}

/**
 * Structured clinical handoff (brief §9/§26) — one model for both doctor
 * and nurse handoffs (distinguished by `type` and the actual role of
 * `fromStaff`/`toStaff`), matching "avoid duplicate business logic."
 * A handoff can never silently disappear: `status` starts PENDING and is
 * only ever flipped to ACKNOWLEDGED by an explicit action, never deleted.
 */
enum HandoffType {
  DOCTOR
  NURSE
}

enum HandoffStatus {
  PENDING
  ACKNOWLEDGED
}

model ClinicalHandoff {
  id                    String                @id @default(cuid())
  facility              Facility              @relation(fields: [facilityId], references: [id])
  facilityId            String
  patient               Patient               @relation(fields: [patientId], references: [id])
  patientId             String
  encounter             Encounter?            @relation(fields: [encounterId], references: [id])
  encounterId           String?
  type                  HandoffType
  fromStaff             HospitalStaffProfile  @relation("HandoffFrom", fields: [fromStaffId], references: [id])
  fromStaffId           String
  toStaff               HospitalStaffProfile? @relation("HandoffTo", fields: [toStaffId], references: [id])
  toStaffId             String?
  urgency               RequestPriority       @default(ROUTINE)
  summary               String
  activeProblems        String?
  pendingInvestigations String?
  pendingMedications    String?
  pendingTasks          String?
  safetyConcerns        String?
  escalationRequired    Boolean               @default(false)
  status                HandoffStatus         @default(PENDING)
  createdAt             DateTime              @default(now())
  acknowledgedAt        DateTime?
  acknowledgedByStaffId String?

  @@index([facilityId])
  @@index([patientId])
  @@index([status])
}

/**
 * Nurse-to-patient assignment (brief §11) — history is never overwritten;
 * ending an assignment sets `endAt` on the existing row, a reassignment
 * is always a new row. `bedId` is denormalized at assignment time (a
 * transfer later doesn't retroactively change who was assigned when).
 */
// Phase 6.7: a partial unique index enforcing "at most one open
// (endAt IS NULL) assignment per patient" is added by hand in
// prisma/migrations/*_phase6_7_nursing_core and mirrored in
// prisma/migrations-postgres-baseline — not expressible in schema.prisma
// syntax, same convention as the exclusion constraints on Payer/Tariff.
// assignNurse() already expressed this invariant in application code; the
// index closes the concurrent-create race where two simultaneous
// assignments could both end the same stale row and both succeed.
model NursingAssignment {
  id                String               @id @default(cuid())
  facility          Facility             @relation(fields: [facilityId], references: [id])
  facilityId        String
  department        Department?          @relation(fields: [departmentId], references: [id])
  departmentId      String?
  nurse             HospitalStaffProfile @relation("NurseAssigned", fields: [nurseStaffId], references: [id])
  nurseStaffId      String
  patient           Patient              @relation(fields: [patientId], references: [id])
  patientId         String
  encounter         Encounter?           @relation(fields: [encounterId], references: [id])
  encounterId       String?
  bed               Bed?                 @relation(fields: [bedId], references: [id])
  bedId             String?
  startAt           DateTime             @default(now())
  endAt             DateTime?
  reason            String?
  assignedByStaffId String
  createdAt         DateTime             @default(now())

  @@index([facilityId])
  @@index([nurseStaffId])
  @@index([patientId])
}

/**
 * Configurable abnormal-vital thresholds (brief §13's explicit "do NOT
 * invent clinical thresholds" — same pattern as Phase 2's `SlaPolicy`:
 * hospital-configured, not a hardcoded clinical claim). No row for a
 * metric means no abnormal-vital alert is generated for it — never a
 * silent default.
 */
model VitalThreshold {
  id         String   @id @default(cuid())
  facility   Facility @relation(fields: [facilityId], references: [id])
  facilityId String
  metric     String // "hr" | "sbp" | "dbp" | "rr" | "spo2" | "tempC"
  minValue   Float?
  maxValue   Float?
  updatedAt  DateTime @updatedAt

  @@unique([facilityId, metric])
}

/**
 * Intake/output documentation (brief §14). Shift/day summaries are computed at read time (sum by ioType/category over a date range), never stored — same aggregation pattern as everywhere else in this codebase.
 */
enum IOType {
  INPUT
  OUTPUT
}

model IntakeOutputRecord {
  id                String    @id @default(cuid())
  encounter         Encounter @relation(fields: [encounterId], references: [id])
  encounterId       String
  facility          Facility  @relation(fields: [facilityId], references: [id])
  facilityId        String
  ioType            IOType
  category          String // INPUT: "ORAL"|"IV"|"ENTERAL"|"OTHER"; OUTPUT: "URINE"|"DRAIN"|"EMESIS"|"STOOL"|"OTHER"
  quantityMl        Float
  recordedByStaffId String
  recordedAt        DateTime  @default(now())
  notes             String?

  @@index([encounterId])
}

// ─────────────────────────────────────────────────────────────────────────
// Medication lifecycle deepening (brief §15-21, §25)
// ─────────────────────────────────────────────────────────────────────────

/**
 * The full prescribe -> pharmacy -> dispense -> administer lifecycle
 * (brief §16). Replaces MedicationOrder's previous loose status STRING
 * with a real enum — safe because every existing row's value ("ORDERED")
 * is itself a member of this enum (verified against live data before
 * this migration), unlike LabOrder/ImagingOrder/Referral/ClinicalNote/
 * Task/Discharge/Appointment/QueueEntry, whose existing status
 * vocabularies stay free-text strings exactly as Phase 0-2 left them —
 * converting those would be the "destructive rewrite" this phase is
 * explicitly told not to do.
 */
enum MedicationOrderStatus {
  DRAFT
  ORDERED
  PHARMACY_REVIEW
  VERIFIED
  DISPENSED
  ACTIVE
  COMPLETED
  CANCELLED
  DISCONTINUED
  HELD
  REJECTED
}

enum MedicationAdministrationStatus {
  DUE
  GIVEN
  HELD
  REFUSED
  MISSED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 4 — Diagnostics OS, Milestone A (Order integration for Lab/Imaging)
// LabOrder/ImagingOrder status graduates from a free-text String to a real
// enum here, using only the states already documented against those fields
// since Phase 0-2 (ORDERED | COLLECTED | IN_PROGRESS | RESULTED | CANCELLED
// for lab; ORDERED | SCHEDULED | ACQUIRED | REPORTED | CANCELLED for
// imaging) — safe because every existing row's value is itself a member of
// the corresponding enum (verified against live data before migration),
// same justification as MedicationOrderStatus above. LabOrder/ImagingOrder
// also gain a nullable+unique orderId back-relation to Order, mirroring
// MedicationOrder.orderId exactly, replacing the previously-unused (0 rows)
// Order.labOrderId/imagingOrderId forward pointers.
// ─────────────────────────────────────────────────────────────────────────

enum LabOrderStatus {
  ORDERED
  COLLECTED
  IN_PROGRESS
  RESULTED
  CANCELLED
}

enum ImagingOrderStatus {
  ORDERED
  SCHEDULED
  ACQUIRED
  REPORTED
  CANCELLED
}

enum SafetySeverity {
  INFO
  WARNING
  DANGER
}

/**
 * Full audit trail of a medication order's safety evaluation — distinct from MedicationOrder.safetyFlags (Phase 0's quick JSON snapshot at order time, left untouched for backward compatibility). Each row is individually acknowledgeable/overridable with an actor and timestamp, which a JSON blob can't support.
 */
model MedicationSafetyWarning {
  id                    String          @id @default(cuid())
  medicationOrder       MedicationOrder @relation(fields: [medicationOrderId], references: [id])
  medicationOrderId     String
  rule                  String // "allergy-conflict" | "duplicate-active-medication" | "route-mismatch" | "frequency-mismatch"
  severity              SafetySeverity
  message               String
  sourceId              String?
  acknowledgedByStaffId String?
  acknowledgedAt        DateTime?
  overrideReason        String?
  createdAt             DateTime        @default(now())

  @@index([medicationOrderId])
}

enum VerificationDecision {
  VERIFIED
  REJECTED
  HOLD
  CLARIFICATION_REQUESTED
}

/**
 * The pharmacist verification audit trail (brief §17) — MedicationOrder.status holds the CURRENT state; this table holds every decision ever made, with a required reason for anything but VERIFIED.
 */
model MedicationVerification {
  id                String               @id @default(cuid())
  medicationOrder   MedicationOrder      @relation(fields: [medicationOrderId], references: [id])
  medicationOrderId String
  pharmacist        HospitalStaffProfile @relation(fields: [pharmacistStaffId], references: [id])
  pharmacistStaffId String
  decision          VerificationDecision
  reason            String?
  createdAt         DateTime             @default(now())

  @@index([medicationOrderId])
}

enum DispenseStatus {
  FULL
  PARTIAL
  SUBSTITUTED
  RETURNED
  CANCELLED
}

/**
 * Dispensing record (brief §23-25). `batchNumber`/`expiryDate` are
 * nullable — captured when available, never fabricated. `witnessStaffId`
 * is the minimum controlled-medication co-sign hook (brief §25); no
 * jurisdiction-specific rule engine is built — whether a witness is
 * required is a simple `MedicationOrder.isControlled` flag, documented
 * as facility-configurable in principle, enforced as a single boolean
 * this phase (see docs/PHASE_3_ARCHITECTURE.md §8).
 */
model DispensingRecord {
  id                  String                @id @default(cuid())
  medicationOrder     MedicationOrder       @relation(fields: [medicationOrderId], references: [id])
  medicationOrderId   String
  pharmacist          HospitalStaffProfile  @relation("DispensingPharmacist", fields: [pharmacistStaffId], references: [id])
  pharmacistStaffId   String
  status              DispenseStatus        @default(FULL)
  quantity            Float
  quantityUnit        String
  batchNumber         String?
  expiryDate          DateTime?
  substitutedDrugName String?
  destination         String?
  witnessStaffId      String?
  witness             HospitalStaffProfile? @relation("DispensingWitness", fields: [witnessStaffId], references: [id])
  notes               String?
  createdAt           DateTime              @default(now())

  // Phase B6 — multi-lot dispensing traceability (all additive). One dispense
  // that draws from multiple lots creates ONE DispensingRecord per lot, sharing
  // a dispenseGroupId, each naming its own lot — never flattened into one opaque
  // record. itemId/itemLotId make the lot→patient trace explicit alongside the
  // canonical StockLedgerEntry (sourceType=DispensingRecord).
  dispenseGroupId String?
  itemId          String?
  itemLotId       String?

  @@index([medicationOrderId])
  @@index([dispenseGroupId])
  @@index([itemLotId])
}

enum ReconciliationSource {
  ADMISSION
  TRANSFER
  DISCHARGE
}

enum ReconciliationDecision {
  CONTINUED
  MODIFIED
  STOPPED
  NEW
}

/**
 * Medication reconciliation (brief §19) — purely additive rows; never deletes prior medication history.
 */
model MedicationReconciliation {
  id                String                 @id @default(cuid())
  encounter         Encounter              @relation(fields: [encounterId], references: [id])
  encounterId       String
  patient           Patient                @relation(fields: [patientId], references: [id])
  patientId         String
  facility          Facility               @relation(fields: [facilityId], references: [id])
  facilityId        String
  source            ReconciliationSource
  medicationName    String
  priorDose         String?
  decision          ReconciliationDecision
  medicationOrderId String?
  reason            String?
  reviewedByStaffId String
  createdAt         DateTime               @default(now())

  @@index([encounterId])
  @@index([patientId])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 6A — Inventory + Procurement Foundation.
//
// A reusable physical-stock engine, deliberately separate from clinical
// concepts (MedicationOrder.drugName stays freeform; MedicationItemLink is
// the clean, optional mapping onto this Item master). StockLedgerEntry is
// the authoritative, append-only history; StockBalance is a derivable,
// reconcilable cache, never an independent source of truth. See
// docs/PHASE_6A_INVENTORY_ARCHITECTURE.md / PHASE_6A_PROCUREMENT.md /
// PHASE_6A_INTEGRITY.md for the full design.
// ─────────────────────────────────────────────────────────────────────────

enum ItemCategory {
  MEDICATION
  CONSUMABLE
  SURGICAL_SUPPLY
  LAB_REAGENT
  RADIOLOGY_CONSUMABLE
  IMPLANT
  EQUIPMENT
  BLOOD_PRODUCT
  OTHER
}

enum UnitOfMeasure {
  TABLET
  CAPSULE
  VIAL
  AMPOULE
  BOTTLE
  BOX
  PACK
  PIECE
  ML
  MG
  GRAM
  KG
  LITER
  OTHER
}

enum LocationType {
  WAREHOUSE
  STORE
  PHARMACY
  OT_STORE
  LAB_STORE
  RADIOLOGY_STORE
  WARD_STORE
  BIN
  OTHER
}

enum LotStatus {
  ACTIVE
  QUARANTINED
  EXPIRED
  RECALLED
  DEPLETED
}

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  RETURN
  WASTE
  ADJUSTMENT
  RESERVATION
  RELEASE
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum StockAdjustmentStatus {
  POSTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum AdjustmentReason {
  COUNT_CORRECTION
  DAMAGE
  LOSS
  FOUND
  DATA_CORRECTION
  OTHER
}

enum WasteRecordStatus {
  POSTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum WasteReason {
  EXPIRED
  DAMAGED
  CONTAMINATED
  OPENED_UNUSED
  ACCIDENTAL_LOSS
}

enum StockTakeStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum RequisitionPriority {
  ROUTINE
  URGENT
  EMERGENCY
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum GoodsReceiptStatus {
  RECORDED
  APPROVED
  REJECTED
}

/**
 * Reusable item master — a PHYSICAL stock concept, not a clinical one.
 * `facilityId` nullable = a global/org-wide catalog item, mirroring
 * LabTestCatalog's facility-nullable convention. `baseUnit` is the one
 * unit every StockLedgerEntry/StockBalance row for this item is recorded
 * in; ItemUnitConversion expresses any other purchasing/dispensing unit
 * in terms of it. Medication-clinical fields (dose, route, frequency) are
 * NOT duplicated here — see MedicationItemLink for the mapping.
 */
model Item {
  id          String        @id @default(cuid())
  facility    Facility?     @relation(fields: [facilityId], references: [id])
  facilityId  String?
  sku         String        @unique
  name        String
  description String?
  category    ItemCategory
  baseUnit    UnitOfMeasure
  active      Boolean       @default(true)
  trackLots   Boolean       @default(true)
  trackExpiry Boolean       @default(true)
  trackSerial Boolean       @default(false) // foundation flag only — no serial-number model this phase

  reorderMinLevel     Float?
  reorderMaxLevel     Float?
  reorderPoint        Float?
  reorderQuantity     Float?
  preferredSupplier   Supplier? @relation(fields: [preferredSupplierId], references: [id])
  preferredSupplierId String?

  // Phase B6 — medication-master metadata (all additive/nullable; only
  // meaningful for category=MEDICATION items, mirroring how Encounter's ED
  // fields are nullable columns rather than a separate table). This is NOT a
  // second medication inventory entity — the Item IS the medication master;
  // MedicationItemLink still bridges MedicationOrder.drugName to it.
  genericName         String?
  brandName           String?
  strength            String?
  dosageForm          String? // "TABLET" | "CAPSULE" | "INJECTION" | "SYRUP" | ... (free-string)
  medicationRoute     String?
  concentration       String?
  therapeuticCategory String?
  controlledClass     String? // configurable controlled-drug schedule label — no legal policy engine
  highAlert           Boolean @default(false)
  storageRequirement  String? // documentary (e.g. "2-8C") — no IoT/telemetry
  barcode             String?
  manufacturer        String?
  packSize            String?
  dispensingUnit      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitConversions    ItemUnitConversion[]
  medicationLinks    MedicationItemLink[]
  lots               ItemLot[]
  stockBalances      StockBalance[]
  stockLedgerEntries StockLedgerEntry[]
  stockReservations  StockReservation[]
  stockTransfers     StockTransfer[]
  stockAdjustments   StockAdjustment[]
  wasteRecords       WasteRecord[]
  stockTakeLines     StockTakeLine[]
  requisitionLines   PurchaseRequisitionLine[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  bloodProducts      BloodProduct[] // Phase B4 — optional blood-product bridge into the item master
  formularyEntries   FormularyEntry[] // Phase B6 — facility formulary listings for this medication

  @@index([facilityId])
  @@index([category])
}

/**
 * Item-scoped unit conversion — "N base units per 1 of this unit" (e.g. 1 BOX = 100 TABLET). Never crosses incompatible dimensions (see inventory/units.ts).
 */
model ItemUnitConversion {
  id               String        @id @default(cuid())
  item             Item          @relation(fields: [itemId], references: [id])
  itemId           String
  unit             UnitOfMeasure
  baseUnitsPerUnit Float

  @@unique([itemId, unit])
}

/**
 * Clean medication -> inventory-item mapping. MedicationOrder.drugName
 * stays freeform on purpose (unchanged clinical semantics) — this table is
 * the optional, explicit bridge the pharmacy dispense flow consults.
 * drugNameKey uses the exact same `.trim().toUpperCase()` normalization
 * medicationLifecycle.ts already applies for its Phase 5 charge code, so
 * there is one normalization convention, not two.
 */
model MedicationItemLink {
  id          String    @id @default(cuid())
  facility    Facility? @relation(fields: [facilityId], references: [id])
  facilityId  String?
  drugNameKey String
  item        Item      @relation(fields: [itemId], references: [id])
  itemId      String
  createdAt   DateTime  @default(now())

  @@unique([facilityId, drugNameKey])
}

/**
 * Facility -> Store/Warehouse -> Bin hierarchy. A stock balance never exists without a meaningful location.
 */
model StockLocation {
  id               String         @id @default(cuid())
  facility         Facility       @relation(fields: [facilityId], references: [id])
  facilityId       String
  name             String
  type             LocationType
  parent           StockLocation? @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  parentLocationId String?
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())

  children           StockLocation[]    @relation("LocationHierarchy")
  stockBalances      StockBalance[]
  stockLedgerEntries StockLedgerEntry[]
  stockReservations  StockReservation[]
  transfersFrom      StockTransfer[]    @relation("TransferFrom")
  transfersTo        StockTransfer[]    @relation("TransferTo")
  stockAdjustments   StockAdjustment[]
  wasteRecords       WasteRecord[]
  stockTakes         StockTake[]
  goodsReceiptLines  GoodsReceiptLine[]
  bloodUnits         BloodUnit[] // Phase B4 — current physical location of a serialized blood unit

  @@unique([facilityId, name])
  @@index([facilityId, active])
}

/**
 * Lot/batch. `lotNumber` is a real supplier-issued batch number for
 * trackLots=true items; a sentinel `"NO-LOT"` row is get-or-created for
 * trackLots=false items (inventory/lots.ts#getOrCreateNoLotSentinel) so
 * every stock row still has a non-null lotId — one code path, not two.
 * Never physically deleted.
 */
model ItemLot {
  id                  String    @id @default(cuid())
  item                Item      @relation(fields: [itemId], references: [id])
  itemId              String
  facility            Facility  @relation(fields: [facilityId], references: [id])
  facilityId          String
  lotNumber           String
  manufacturer        String?
  manufacturedAt      DateTime?
  expiresAt           DateTime? // null = never expires
  status              LotStatus @default(ACTIVE)
  quarantineReason    String?
  quarantinedAt       DateTime?
  quarantinedByUserId String?
  releasedAt          DateTime?
  releasedByUserId    String?
  createdAt           DateTime  @default(now())

  stockBalances      StockBalance[]
  stockLedgerEntries StockLedgerEntry[]
  stockReservations  StockReservation[]
  stockTransfers     StockTransfer[]
  stockAdjustments   StockAdjustment[]
  wasteRecords       WasteRecord[]
  stockTakeLines     StockTakeLine[]
  bloodUnits         BloodUnit[] // Phase B4 — serialized blood units carry a canonical lot for batch/recall traceability

  @@unique([itemId, facilityId, lotNumber])
  @@index([facilityId, status])
  @@index([expiresAt])
}

/**
 * The authoritative, append-only stock history — the single most
 * important model in this phase. Every material stock change is exactly
 * one row here (a transfer is exactly two: TRANSFER_OUT + TRANSFER_IN).
 * Enforced immutable BY CONVENTION: no service code ever calls .update()
 * or .delete() on this model (verified in review, same discipline as
 * Charge/PaymentAllocation) — a correction is a new, opposite-direction
 * entry, never a rewrite. Idempotency key is (sourceType, sourceId,
 * movementType) — sufficient because this phase's scope cut is "one lot
 * fulfills one movement line" (see docs/PHASE_6A_INTEGRITY.md), so lotId
 * need not be part of the key.
 */
model StockLedgerEntry {
  id           String            @id @default(cuid())
  facility     Facility          @relation(fields: [facilityId], references: [id])
  facilityId   String
  item         Item              @relation(fields: [itemId], references: [id])
  itemId       String
  lot          ItemLot           @relation(fields: [lotId], references: [id])
  lotId        String
  location     StockLocation     @relation(fields: [locationId], references: [id])
  locationId   String
  movementType StockMovementType

  // RECEIPT/ISSUE/WASTE/ADJUSTMENT/TRANSFER move onHandDelta; RESERVATION/
  // RELEASE move only reservedDelta; an issue that consumes a prior
  // reservation moves both in the same entry.
  onHandDelta   Float         @default(0)
  reservedDelta Float         @default(0)
  unit          UnitOfMeasure // denormalized item.baseUnit at post time

  wasteReason      WasteReason?
  adjustmentReason AdjustmentReason?
  reason           String?
  notes            String?

  sourceType      String?
  sourceId        String?
  movementGroupId String? // links a TRANSFER_OUT+TRANSFER_IN pair for display only — not the idempotency mechanism

  patientId   String?
  encounterId String?

  actorUserId  String
  actorStaffId String?
  postedAt     DateTime @default(now())

  @@unique([sourceType, sourceId, movementType])
  @@index([facilityId, itemId, lotId, locationId])
  @@index([facilityId, movementType, postedAt])
  @@index([facilityId, postedAt])
  @@index([patientId])
  @@index([encounterId])
  @@index([sourceType, sourceId])
}

/**
 * Materialized, reconcilable current-balance cache. NEVER hand-decremented
 * in application code — every mutation goes through one of the atomic
 * conditional-update primitives in inventory/stockBalance.ts. The ledger
 * (above) is authoritative; this balance must always be derivable by
 * summing StockLedgerEntry deltas grouped by (itemId, lotId, locationId) —
 * see the reconciliation report route.
 */
model StockBalance {
  id          String        @id @default(cuid())
  facility    Facility      @relation(fields: [facilityId], references: [id])
  facilityId  String
  item        Item          @relation(fields: [itemId], references: [id])
  itemId      String
  lot         ItemLot       @relation(fields: [lotId], references: [id])
  lotId       String
  location    StockLocation @relation(fields: [locationId], references: [id])
  locationId  String
  onHandQty   Float         @default(0)
  reservedQty Float         @default(0)
  updatedAt   DateTime      @updatedAt

  @@unique([itemId, lotId, locationId])
  @@index([facilityId, itemId])
  @@index([facilityId, locationId])
}

/**
 * Reserves stock ahead of consumption (future OT/ICU/procedure/pharmacy/blood-product use) — reduces AVAILABLE, never onHand, until consumed or released.
 */
model StockReservation {
  id                 String                 @id @default(cuid())
  facility           Facility               @relation(fields: [facilityId], references: [id])
  facilityId         String
  item               Item                   @relation(fields: [itemId], references: [id])
  itemId             String
  lot                ItemLot                @relation(fields: [lotId], references: [id]) // FEFO-selected at reservation time
  lotId              String
  location           StockLocation          @relation(fields: [locationId], references: [id])
  locationId         String
  quantity           Float
  status             StockReservationStatus @default(ACTIVE)
  reservedForType    String?
  reservedForId      String?
  patientId          String?
  encounterId        String?
  requestedByStaffId String
  expiresAt          DateTime? // staff-observed only, never auto-transitioned — no cron in this codebase
  releasedAt         DateTime?
  releasedByUserId   String?
  idempotencyKey     String                 @unique
  createdAt          DateTime               @default(now())

  @@index([facilityId, itemId, lotId, locationId])
  @@index([status])
}

/**
 * Location-to-location stock move, same facility only this phase.
 */
model StockTransfer {
  id                 String              @id @default(cuid())
  facility           Facility            @relation(fields: [facilityId], references: [id])
  facilityId         String
  item               Item                @relation(fields: [itemId], references: [id])
  itemId             String
  lot                ItemLot             @relation(fields: [lotId], references: [id])
  lotId              String
  fromLocation       StockLocation       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  fromLocationId     String
  toLocation         StockLocation       @relation("TransferTo", fields: [toLocationId], references: [id])
  toLocationId       String
  quantity           Float
  status             StockTransferStatus @default(DRAFT)
  reason             String?
  requestedByStaffId String
  initiatedAt        DateTime?
  receivedByStaffId  String?
  receivedAt         DateTime?
  cancelledAt        DateTime?
  cancelledReason    String?
  idempotencyKey     String              @unique
  createdAt          DateTime            @default(now())

  @@index([facilityId, status])
}

/**
 * Controlled quantity correction. Normal-impact posts immediately (POSTED); high-impact is gated behind approval (PENDING_APPROVAL) with a same-actor guard.
 */
model StockAdjustment {
  id                 String                @id @default(cuid())
  facility           Facility              @relation(fields: [facilityId], references: [id])
  facilityId         String
  item               Item                  @relation(fields: [itemId], references: [id])
  itemId             String
  lot                ItemLot               @relation(fields: [lotId], references: [id])
  lotId              String
  location           StockLocation         @relation(fields: [locationId], references: [id])
  locationId         String
  quantityDelta      Float // signed
  reason             AdjustmentReason
  notes              String?
  status             StockAdjustmentStatus @default(POSTED)
  requestedByStaffId String
  approvedByStaffId  String?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  sourceType         String? // e.g. "StockTakeLine" when auto-created by a completed stocktake
  sourceId           String?
  idempotencyKey     String                @unique
  createdAt          DateTime              @default(now())

  stockTakeLine StockTakeLine?

  @@index([facilityId, status])
}

/**
 * Explicit waste record — its own ledger movement type, never an invisible quantity decrement.
 */
model WasteRecord {
  id                 String            @id @default(cuid())
  facility           Facility          @relation(fields: [facilityId], references: [id])
  facilityId         String
  item               Item              @relation(fields: [itemId], references: [id])
  itemId             String
  lot                ItemLot           @relation(fields: [lotId], references: [id])
  lotId              String
  location           StockLocation     @relation(fields: [locationId], references: [id])
  locationId         String
  quantity           Float // positive magnitude
  reason             WasteReason
  status             WasteRecordStatus @default(POSTED)
  patientId          String?
  encounterId        String?
  requestedByStaffId String
  approvedByStaffId  String?
  approvedAt         DateTime?
  notes              String?
  idempotencyKey     String            @unique
  createdAt          DateTime          @default(now())

  @@index([facilityId, status])
}

/**
 * Physical stock count foundation. A variance NEVER silently overwrites systemQuantity — completing the stocktake creates one StockAdjustment per non-zero-variance line.
 */
model StockTake {
  id                 String          @id @default(cuid())
  facility           Facility        @relation(fields: [facilityId], references: [id])
  facilityId         String
  location           StockLocation   @relation(fields: [locationId], references: [id])
  locationId         String
  status             StockTakeStatus @default(DRAFT)
  startedByStaffId   String
  startedAt          DateTime?
  completedByStaffId String?
  completedAt        DateTime?
  cancelledAt        DateTime?
  notes              String?
  createdAt          DateTime        @default(now())

  lines StockTakeLine[]

  @@index([facilityId, locationId, status])
}

model StockTakeLine {
  id                    String           @id @default(cuid())
  stockTake             StockTake        @relation(fields: [stockTakeId], references: [id])
  stockTakeId           String
  item                  Item             @relation(fields: [itemId], references: [id])
  itemId                String
  lot                   ItemLot          @relation(fields: [lotId], references: [id])
  lotId                 String
  systemQuantity        Float // snapshotted when the line is added
  countedQuantity       Float?
  varianceQuantity      Float? // countedQuantity - systemQuantity, computed at count-entry time
  resultingAdjustment   StockAdjustment? @relation(fields: [resultingAdjustmentId], references: [id])
  resultingAdjustmentId String?          @unique

  @@unique([stockTakeId, itemId, lotId])
}

/**
 * Facility ownership, business contact info only — no unnecessary personal data.
 */
model Supplier {
  id               String   @id @default(cuid())
  facility         Facility @relation(fields: [facilityId], references: [id])
  facilityId       String
  name             String
  code             String
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  address          String?
  paymentTermsDays Int?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  preferredForItems Item[]
  purchaseOrders    PurchaseOrder[]

  @@unique([facilityId, code])
}

/**
 * Copies billing/sequence.ts's InvoiceSequence idiom exactly, one dedicated table per numbered-document type (established convention — not a generalized shared sequencer).
 */
model PurchaseRequisitionSequence {
  id         String   @id @default(cuid())
  facility   Facility @relation(fields: [facilityId], references: [id])
  facilityId String
  fiscalYear Int
  nextValue  Int      @default(1)

  @@unique([facilityId, fiscalYear])
}

model PurchaseRequisition {
  id                      String              @id @default(cuid())
  requisitionNumber       String? // assigned atomically at SUBMIT; scoped unique per facility, not globally (see @@unique below) — the sequence counter itself resets per facility+fiscalYear, so the formatted number is only guaranteed unique within one facility
  facility                Facility            @relation(fields: [facilityId], references: [id])
  facilityId              String
  department              Department          @relation(fields: [departmentId], references: [id])
  departmentId            String
  requestedByStaffId      String
  status                  RequisitionStatus   @default(DRAFT)
  priority                RequisitionPriority @default(ROUTINE)
  justification           String
  requiredByDate          DateTime?
  supersedesRequisitionId String? // a "revision" is cancel + clone into a new DRAFT, never an in-place edit
  submittedAt             DateTime?
  approvedAt              DateTime?
  approvedByStaffId       String?
  rejectedAt              DateTime?
  rejectedByStaffId       String?
  rejectionReason         String?
  cancelledAt             DateTime?
  cancelledReason         String?
  idempotencyKey          String              @unique
  createdAt               DateTime            @default(now())

  lines          PurchaseRequisitionLine[]
  purchaseOrders PurchaseOrder[]

  @@unique([facilityId, requisitionNumber])
  @@index([facilityId, status])
}

model PurchaseRequisitionLine {
  id               String              @id @default(cuid())
  requisition      PurchaseRequisition @relation(fields: [requisitionId], references: [id])
  requisitionId    String
  item             Item                @relation(fields: [itemId], references: [id])
  itemId           String
  quantity         Float
  unit             UnitOfMeasure
  approvedQuantity Float? // immutable once the requisition is APPROVED (service-level guard)
  notes            String?

  @@index([requisitionId])
}

model PurchaseOrderSequence {
  id         String   @id @default(cuid())
  facility   Facility @relation(fields: [facilityId], references: [id])
  facilityId String
  fiscalYear Int
  nextValue  Int      @default(1)

  @@unique([facilityId, fiscalYear])
}

model PurchaseOrder {
  id                   String               @id @default(cuid())
  orderNumber          String? // assigned atomically on DRAFT -> PENDING_APPROVAL; scoped unique per facility, not globally (see @@unique below)
  facility             Facility             @relation(fields: [facilityId], references: [id])
  facilityId           String
  supplier             Supplier             @relation(fields: [supplierId], references: [id])
  supplierId           String
  requisition          PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  requisitionId        String?
  status               PurchaseOrderStatus  @default(DRAFT)
  currency             String               @default("INR")
  subtotalMinor        Int                  @default(0)
  taxMinor             Int                  @default(0)
  totalMinor           Int                  @default(0) // always server-computed — see procurement/pricing.ts
  expectedDeliveryDate DateTime?
  createdByStaffId     String
  approvedByStaffId    String?
  approvedAt           DateTime?
  sentAt               DateTime?
  cancelledAt          DateTime?
  cancelledReason      String?
  closedAt             DateTime?
  idempotencyKey       String               @unique
  createdAt            DateTime             @default(now())

  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@unique([facilityId, orderNumber])
  @@index([facilityId, status])
}

model PurchaseOrderLine {
  id               String        @id @default(cuid())
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId  String
  item             Item          @relation(fields: [itemId], references: [id])
  itemId           String
  orderedQuantity  Float
  unit             UnitOfMeasure
  unitPriceMinor   Int
  taxPercent       Float         @default(0)
  lineTotalMinor   Int // server-computed via billing/money.ts helpers, never trusted from the client
  receivedQuantity Float         @default(0) // ceiling-guarded running total, incremented only via goodsReceipts.ts's raw UPDATE

  goodsReceiptLines GoodsReceiptLine[]

  @@index([purchaseOrderId])
}

model GoodsReceiptSequence {
  id         String   @id @default(cuid())
  facility   Facility @relation(fields: [facilityId], references: [id])
  facilityId String
  fiscalYear Int
  nextValue  Int      @default(1)

  @@unique([facilityId, fiscalYear])
}

/**
 * idempotencyKey is the natural key for "this receiving submission" — NOT purchaseOrderLineId alone, which would wrongly forbid legitimate multiple partial deliveries against the same line.
 */
model GoodsReceipt {
  id                String             @id @default(cuid())
  receiptNumber     String? // scoped unique per facility, not globally (see @@unique below)
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId   String
  facility          Facility           @relation(fields: [facilityId], references: [id])
  facilityId        String
  status            GoodsReceiptStatus @default(RECORDED)
  recordedByStaffId String
  recordedAt        DateTime           @default(now())
  approvedByStaffId String?
  approvedAt        DateTime?
  rejectedByStaffId String?
  rejectedAt        DateTime?
  rejectionReason   String?
  idempotencyKey    String             @unique
  notes             String?

  lines GoodsReceiptLine[]

  @@unique([facilityId, receiptNumber])
  @@index([purchaseOrderId])
  @@index([facilityId, status])
}

model GoodsReceiptLine {
  id                  String            @id @default(cuid())
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id])
  goodsReceiptId      String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  purchaseOrderLineId String
  item                Item              @relation(fields: [itemId], references: [id])
  itemId              String
  lotNumber           String
  manufacturer        String?
  manufacturedAt      DateTime?
  expiresAt           DateTime?
  acceptedQuantity    Float
  rejectedQuantity    Float             @default(0) // captured, never enters usable stock
  rejectionReason     String?
  location            StockLocation     @relation(fields: [locationId], references: [id])
  locationId          String
  unit                UnitOfMeasure

  @@index([purchaseOrderLineId])
  @@index([goodsReceiptId])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase B4 — Blood Bank & Transfusion Management
// Composes the canonical Patient/Encounter/ADT/ClinicalNote/Item-ItemLot/
// AuditEvent systems — no parallel patient/encounter/inventory/audit. Blood
// units are SERIALIZED (each unit is one discrete, individually-tracked row),
// so a unit's own status column is the concurrency-control point: a guarded
// updateMany transition (WHERE id=? AND status=?) is single-winner per unit —
// the correct model for serialized stock and the reason a dedicated BloodUnit
// exists rather than forcing serialized units through the fungible quantity-
// based StockBalance. Canonical inventory is still referenced (BloodProduct.item,
// BloodUnit.itemLot/location) for batch/recall traceability — NO second stock
// ledger is created. Child records (compat test, reservation, issue, transfusion,
// reaction) copy patientId/encounterId/facilityId from the parent request/unit,
// never from the client (wrong-patient-safe by construction, same pattern as
// SurgicalSpecimen). HARD SAFETY BOUNDARY: no ABO/Rh compatibility algorithm,
// no antibody-screen/crossmatch interpretation, no severity/reaction inference,
// no dosing/threshold logic — the app records explicit lab/authorized results
// and enforces configured workflow states only.
// ─────────────────────────────────────────────────────────────────────────

enum AboGroup {
  A
  B
  AB
  O
}

enum RhStatus {
  POSITIVE
  NEGATIVE
}

enum BloodUnitStatus {
  AVAILABLE
  RESERVED
  ISSUED
  IN_TRANSIT
  TRANSFUSING
  TRANSFUSED
  RETURNED
  WASTED
  QUARANTINED
  EXPIRED
  DISCARDED
}

enum BloodRequestStatus {
  REQUESTED
  REVIEWED
  APPROVED
  COMPATIBILITY_PENDING
  READY
  ISSUED
  COMPLETED
  CANCELLED
  REJECTED
}

enum BloodRequestPriority {
  ROUTINE
  URGENT
  EMERGENCY
}

enum BloodCompatibilityStatus {
  PENDING
  IN_PROGRESS
  COMPATIBLE
  INCOMPATIBLE
  CANCELLED
}

enum BloodReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum TransfusionStatus {
  RECEIVED
  IN_PROGRESS
  PAUSED
  COMPLETED
  STOPPED
}

enum TransfusionReactionStatus {
  REPORTED
  UNDER_REVIEW
  ESCALATED
  RESOLVED
}

/**
 * Configurable blood-product master (not a hardcoded global taxonomy). Optionally bridges to the canonical Item catalog for inventory integration.
 */
model BloodProduct {
  id                     String   @id @default(cuid())
  facility               Facility @relation(fields: [facilityId], references: [id])
  facilityId             String
  code                   String
  name                   String
  componentType          String // configurable: "WHOLE_BLOOD" | "PRBC" | "FFP" | "PLATELETS" | "CRYOPRECIPITATE" | ... (extensible)
  defaultUnitDescription String?
  storageRequirement     String? // free-text configurable label; no invented temperature/shelf-life rule
  active                 Boolean  @default(true)
  item                   Item?    @relation(fields: [itemId], references: [id])
  itemId                 String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  units    BloodUnit[]
  requests BloodRequest[]

  @@unique([facilityId, code])
  @@index([facilityId])
}

/**
 * An individual, serialized blood unit — the authoritative inventory record for
 * that physical unit. `status` is the concurrency-control point (guarded
 * updateMany). Blood group is only ever an explicitly-recorded/authorized value,
 * never inferred. New units default to QUARANTINED (testing pending) and must be
 * explicitly released to AVAILABLE.
 */
model BloodUnit {
  id                  String          @id @default(cuid())
  facility            Facility        @relation(fields: [facilityId], references: [id])
  facilityId          String
  product             BloodProduct    @relation(fields: [productId], references: [id])
  productId           String
  unitNumber          String // unique traceable identifier within the facility
  aboGroup            AboGroup? // explicit recorded result, never inferred from demographics
  rhStatus            RhStatus?
  bloodGroupStatus    String          @default("PENDING") // "PENDING" | "CONFIRMED" — set only from an authorized typing record
  collectedAt         DateTime?
  expiresAt           DateTime? // null = unknown; enforced server-side when present
  status              BloodUnitStatus @default(QUARANTINED)
  itemLot             ItemLot?        @relation(fields: [itemLotId], references: [id]) // canonical batch/recall traceability
  itemLotId           String?
  location            StockLocation?  @relation(fields: [locationId], references: [id])
  locationId          String?
  donorReference      String? // minimal source reference — NOT a donor CRM
  sourceOrganization  String?
  collectionEventRef  String?
  quarantineReason    String?
  recalled            Boolean         @default(false)
  recallReason        String?
  notes               String?
  registeredByStaffId String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  typingRecords      BloodTypingRecord[]
  compatibilityTests BloodCompatibilityTest[]
  reservations       BloodReservation[]
  issues             BloodIssue[]
  transfusions       Transfusion[]
  reactions          TransfusionReaction[]

  @@unique([facilityId, unitNumber])
  @@index([facilityId, status])
  @@index([productId])
  @@index([expiresAt])
}

/**
 * Blood typing / type-&-screen record. References EITHER a patient (recipient
 * type & screen) or a unit (donor unit typing) — never invents a group. Result
 * fields hold explicitly-provided lab values; interpretation is out of scope.
 */
model BloodTypingRecord {
  id                 String     @id @default(cuid())
  facilityId         String
  patientId          String? // recipient typing (from a specimen), plain FK — no parallel patient record
  encounterId        String?
  unit               BloodUnit? @relation(fields: [unitId], references: [id])
  unitId             String?
  aboGroup           AboGroup?
  rhStatus           RhStatus?
  antibodyScreen     String? // explicitly-provided result text, not interpreted
  specimenRef        String?
  status             String     @default("PENDING") // "PENDING" | "RESULTED" | "VERIFIED"
  performedByStaffId String?
  verifiedByStaffId  String?
  verifiedAt         DateTime?
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([facilityId])
  @@index([patientId])
  @@index([unitId])
}

/**
 * Transfusion / blood request. Real Patient/Encounter/Facility relations (like Surgery); children derive identity from here.
 */
model BloodRequest {
  id                           String               @id @default(cuid())
  facility                     Facility             @relation(fields: [facilityId], references: [id])
  facilityId                   String
  patient                      Patient              @relation(fields: [patientId], references: [id])
  patientId                    String
  encounter                    Encounter            @relation(fields: [encounterId], references: [id])
  encounterId                  String
  product                      BloodProduct?        @relation(fields: [productId], references: [id])
  productId                    String?
  productName                  String // denormalized at request time so history is stable
  quantity                     Int                  @default(1)
  priority                     BloodRequestPriority @default(ROUTINE)
  indication                   String?
  status                       BloodRequestStatus   @default(REQUESTED)
  requestedByStaffId           String
  requestedAt                  DateTime             @default(now())
  requiredBy                   DateTime?
  reviewedByStaffId            String?
  reviewedAt                   DateTime?
  approvedByStaffId            String?
  approvedAt                   DateTime?
  cancelledReason              String?
  cancelledAt                  DateTime?
  // Emergency release (explicit authorized action; no invented universal-donor or emergency-compatibility policy).
  emergencyRelease             Boolean              @default(false)
  emergencyReason              String?
  emergencyAuthorizedByStaffId String?
  emergencyAuthorizedAt        DateTime?
  surgeryId                    String? // OT integration (a surgery may request blood) — plain FK, no B3 model churn
  notes                        String?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  compatibilityTests BloodCompatibilityTest[]
  reservations       BloodReservation[]
  issues             BloodIssue[]
  transfusions       Transfusion[]

  @@index([facilityId, status])
  @@index([patientId])
  @@index([encounterId])
  @@index([surgeryId])
}

/**
 * Compatibility testing (type & screen / crossmatch). Records explicitly-entered
 * laboratory results + authorized verification — NEVER computes ABO/Rh
 * compatibility. A unit is issued only after a COMPATIBLE, verified result
 * (or an explicit emergency release), never on raw ABO equality.
 */
model BloodCompatibilityTest {
  id                String                   @id @default(cuid())
  facilityId        String
  request           BloodRequest             @relation(fields: [requestId], references: [id])
  requestId         String
  patientId         String // derived from request
  encounterId       String // derived from request
  unit              BloodUnit?               @relation(fields: [unitId], references: [id])
  unitId            String?
  testType          String                   @default("CROSSMATCH") // "TYPE_AND_SCREEN" | "CROSSMATCH"
  aboResult         AboGroup?
  rhResult          RhStatus?
  antibodyScreen    String? // explicitly-provided result text
  crossmatchResult  String? // explicitly-recorded lab result label, not computed
  status            BloodCompatibilityStatus @default(PENDING)
  testedByStaffId   String?
  verifiedByStaffId String?
  verifiedAt        DateTime?
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([facilityId])
  @@index([requestId])
  @@index([unitId])
}

/**
 * Reservation of a specific unit for a request. The unit's AVAILABLE->RESERVED status guard is the actual double-reservation race barrier; this row records the linkage/history.
 */
model BloodReservation {
  id                String                 @id @default(cuid())
  facilityId        String
  unit              BloodUnit              @relation(fields: [unitId], references: [id])
  unitId            String
  request           BloodRequest           @relation(fields: [requestId], references: [id])
  requestId         String
  patientId         String // derived from request
  encounterId       String // derived from request
  status            BloodReservationStatus @default(ACTIVE)
  reservedByStaffId String
  expiresAt         DateTime?
  releasedAt        DateTime?
  releasedReason    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([facilityId])
  @@index([unitId])
  @@index([requestId])
  @@index([patientId])
}

/**
 * Issue of a unit from the blood bank to a clinical area, incl. transport/receipt handoff.
 */
model BloodIssue {
  id                  String       @id @default(cuid())
  facilityId          String
  unit                BloodUnit    @relation(fields: [unitId], references: [id])
  unitId              String
  request             BloodRequest @relation(fields: [requestId], references: [id])
  requestId           String
  patientId           String // derived
  encounterId         String // derived
  compatibilityTestId String? // verification link
  emergencyRelease    Boolean      @default(false)
  status              String       @default("ISSUED") // "ISSUED" | "IN_TRANSIT" | "RECEIVED" | "RETURNED"
  issuedByStaffId     String
  issueLocation       String?
  recipientLocation   String?
  dispatchedByStaffId String?
  dispatchedAt        DateTime?
  receivedByStaffId   String?
  receivedAt          DateTime?
  returnedReason      String?
  returnedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([facilityId])
  @@index([unitId])
  @@index([requestId])
  @@index([patientId])
}

/**
 * Bedside transfusion record. Structured bedside verification is documentation support, not a replacement for institutional bedside policy. Issue != transfusion.
 */
model Transfusion {
  id                      String            @id @default(cuid())
  facility                Facility          @relation(fields: [facilityId], references: [id])
  facilityId              String
  request                 BloodRequest      @relation(fields: [requestId], references: [id])
  requestId               String
  unit                    BloodUnit         @relation(fields: [unitId], references: [id])
  unitId                  String
  patientId               String // derived
  encounterId             String // derived
  productName             String // derived from the unit's product
  status                  TransfusionStatus @default(RECEIVED)
  administeredByStaffId   String?
  patientIdentityVerified Boolean           @default(false)
  unitIdentityVerified    Boolean           @default(false)
  productVerified         Boolean           @default(false)
  bloodGroupReviewed      Boolean           @default(false)
  compatibilityReviewed   Boolean           @default(false)
  expiryReviewed          Boolean           @default(false)
  secondCheckStaffId      String?
  verifiedAt              DateTime?
  startedAt               DateTime?
  pausedAt                DateTime?
  endedAt                 DateTime?
  stoppedReason           String?
  notes                   String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  observations TransfusionObservation[]
  reactions    TransfusionReaction[]

  @@index([facilityId, status])
  @@index([requestId])
  @@index([unitId])
  @@index([patientId])
}

/**
 * Transfusion-specific observation. Canonical Vital is reused for true vitals; this captures observations tied to the transfusion timeline.
 */
model TransfusionObservation {
  id                String      @id @default(cuid())
  transfusion       Transfusion @relation(fields: [transfusionId], references: [id])
  transfusionId     String
  observationType   String // "TEMPERATURE" | "PULSE" | "BP" | "RR" | "SPO2" | "NOTE" | ... (free-string)
  value             String
  recordedByStaffId String
  recordedAt        DateTime    @default(now())

  @@index([transfusionId])
}

/**
 * Transfusion reaction / incident — a RECORDING workflow only. Symptoms and
 * action-taken are documented as entered; the system never diagnoses the
 * reaction, infers severity, or recommends treatment. Reporting a reaction
 * quarantines the associated unit (never returns it to available inventory).
 */
model TransfusionReaction {
  id                String                    @id @default(cuid())
  facilityId        String
  transfusion       Transfusion               @relation(fields: [transfusionId], references: [id])
  transfusionId     String
  unit              BloodUnit                 @relation(fields: [unitId], references: [id])
  unitId            String
  patientId         String // derived
  encounterId       String // derived
  status            TransfusionReactionStatus @default(REPORTED)
  reportedByStaffId String
  reportedAt        DateTime                  @default(now())
  symptoms          String? // as documented — never auto-diagnosed
  actionTaken       String? // as documented — no treatment recommendation
  escalationRef     String?
  resolvedByStaffId String?
  resolvedAt        DateTime?
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([facilityId])
  @@index([transfusionId])
  @@index([unitId])
  @@index([patientId])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase B5 — Emergency Department / Emergency Care Operating System
// An ORCHESTRATION layer over the canonical clinical core. An ED visit is a
// canonical Encounter (type=ED) — NOT a new patient/encounter/bed system.
// Triage (TriageAssessment), current location (EncounterLocation + Bed),
// vitals (Vital), notes (ClinicalNote), tasks (Task), nursing
// (NursingAssignment), diagnostics (Lab/Imaging), meds (MedicationOrder),
// blood (B4), handoffs (ClinicalHandoff), and admission/transfer/discharge
// (ADT: admitPatient/transferPatient) are all REUSED. These three narrow
// models add only what the ED needs that no canonical record already carries:
// repeated reassessment, an explicit high-acuity/resuscitation workflow, and
// the terminal ED disposition. NO triage/severity/sepsis/stroke/cardiac/AI
// algorithm — every acuity/priority is a clinician-entered value the system
// only records, sorts, and displays.
// ─────────────────────────────────────────────────────────────────────────

enum EdResuscitationStatus {
  ACTIVATED
  ACTIVE
  STABILIZED
  HANDED_OVER
  DISPOSITION_PENDING
  CLOSED
}

enum EdDispositionType {
  DISCHARGE
  ADMIT_WARD
  ADMIT_ICU
  TO_OT
  TRANSFER_OUT
  REFERRAL
  LAMA // left against medical advice (after being seen)
  DAMA // discharge against medical advice
  LWBS // left without being seen (never assessed)
  ABSCONDED
  DECEASED
}

/**
 * A recorded ED reassessment (brief §10). Emergency care re-checks a patient
 * repeatedly; each reassessment is an append-only record referencing the
 * clinician/nurse and (optionally) the canonical Vital captured at the time.
 * `escalationRequired` is a clinician-recorded flag, never inferred — it may
 * spawn a canonical Task, but generates no diagnosis.
 */
model EdReassessment {
  id                  String    @id @default(cuid())
  encounter           Encounter @relation(fields: [encounterId], references: [id])
  encounterId         String
  facilityId          String
  patientId           String // derived from the encounter, never client-supplied
  reassessedByStaffId String
  findings            String?
  vitalId             String? // optional link to the canonical Vital recorded at reassessment
  taskId              String? // optional canonical Task spawned for follow-up
  escalationRequired  Boolean   @default(false)
  createdAt           DateTime  @default(now())

  @@index([encounterId])
  @@index([facilityId])
  @@index([patientId])
}

/**
 * Explicit high-acuity / resuscitation workflow (brief §8). ALWAYS explicitly
 * activated by authorized staff — never auto-inferred from vitals. At most one
 * open (status <> CLOSED) row per encounter is enforced by a hand-written
 * partial unique index (see the B5 migration), the same idiom as the nursing
 * "one open assignment" index — this makes concurrent activation single-winner.
 */
model EdResuscitation {
  id                 String                @id @default(cuid())
  encounter          Encounter             @relation(fields: [encounterId], references: [id])
  encounterId        String
  facilityId         String
  patientId          String // derived from the encounter
  status             EdResuscitationStatus @default(ACTIVATED)
  reason             String?
  activatedByStaffId String
  activatedAt        DateTime              @default(now())
  closedByStaffId    String?
  closedAt           DateTime?
  notes              String?
  updatedAt          DateTime              @updatedAt

  @@index([encounterId])
  @@index([facilityId])
}

/**
 * The terminal ED disposition (brief §17-19). `encounterId` is UNIQUE — the
 * single-winner guarantee for "two users disposition the same encounter"
 * (identical mechanism to Admission.encounterId being unique). Admit
 * dispositions flow through the canonical admitPatient() (ADT); discharge/
 * LAMA/DAMA/LWBS/absconded/referral/transfer/death close the canonical
 * Encounter via the existing transitionEncounter(). DECEASED is only a
 * documentary workflow outcome — no medical certification logic — and is
 * role-gated (ed:disposition:death). Observation is NOT a disposition (it is a
 * location state); it deliberately does not consume this row.
 */
model EdDisposition {
  id                     String            @id @default(cuid())
  encounter              Encounter         @relation(fields: [encounterId], references: [id])
  encounterId            String            @unique
  facilityId             String
  patientId              String // derived from the encounter
  type                   EdDispositionType
  destinationDetail      String?
  reason                 String?
  transferFacilityName   String?
  admissionId            String? // set when the disposition admitted via ADT
  handoffId              String? // set when a handoff accompanied the disposition
  lastKnownLocation      String? // captured for LWBS/absconded
  dispositionedByStaffId String
  dispositionAt          DateTime          @default(now())
  note                   String?

  @@index([facilityId])
  @@index([patientId])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase B6 — Enterprise Pharmacy & Medication Supply Chain
// An ORCHESTRATION layer over the canonical medication + inventory core.
// MedicationOrder stays the clinical order; Item/ItemLot/StockBalance/
// StockLedgerEntry/StockReservation/StockTransfer/WasteRecord stay the physical
// stock system (every movement still goes through issueStock/reserveStock/
// recordWaste/initiateTransfer/quarantineLot — never a second ledger);
// MedicationAdministration stays the MAR; AuditEvent stays the audit log.
// These models add only pharmacy-operational records: the facility formulary,
// ward/department requests, medication returns, recalls, authorized
// substitutions, and documentary storage checks. NO dosing/interaction/
// substitution-recommendation/AI logic — record/verify/dispense/return/
// quarantine/recall/trace/reconcile only.
// ─────────────────────────────────────────────────────────────────────────

enum PharmacyRequestStatus {
  REQUESTED
  APPROVED
  RESERVED
  ISSUED
  RECEIVED
  CANCELLED
  REJECTED
}

enum MedicationReturnSource {
  WARD
  PATIENT
  CANCELLED_ORDER
  DISCHARGE
  OTHER
}

enum MedicationReturnClassification {
  RETURN_TO_STOCK
  QUARANTINE
  WASTAGE
}

enum MedicationReturnStatus {
  PENDING_INSPECTION
  COMPLETED
  CANCELLED
}

enum MedicationRecallStatus {
  OPEN
  CLOSED
}

/**
 * Facility-scoped, effective-dated formulary. Deactivating sets active=false +
 * effectiveTo — history is never overwritten (a re-listing is a new row). Being
 * non-formulary NEVER hard-blocks clinical treatment; it is a
 * verification-context flag (+ optional requiresAuthorization) surfaced to the
 * pharmacist, not an ordering gate.
 */
model FormularyEntry {
  id                    String    @id @default(cuid())
  facility              Facility  @relation(fields: [facilityId], references: [id])
  facilityId            String
  item                  Item      @relation(fields: [itemId], references: [id])
  itemId                String
  active                Boolean   @default(true)
  effectiveFrom         DateTime  @default(now())
  effectiveTo           DateTime?
  restrictions          String?
  requiresAuthorization Boolean   @default(false)
  notes                 String?
  createdByStaffId      String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([facilityId, itemId])
  @@index([facilityId, active])
}

/**
 * Operational medication request from a ward/ICU/ED/OT to the pharmacy.
 * REQUESTED -> REVIEWED/APPROVED -> RESERVED -> ISSUED -> RECEIVED (guarded
 * updateMany transitions = single-winner). Reserve/issue/transfer all go
 * through the canonical inventory services (reservationId/transferId link the
 * real rows) — this model is the request envelope, not a stock ledger.
 * itemId/locationId/patient/encounter/facility are plain FKs validated
 * server-side (never client-trusted), same pattern as the B3-B5 child records.
 */
model PharmacyRequest {
  id                   String                @id @default(cuid())
  facilityId           String
  itemId               String
  quantity             Float
  unit                 String?
  requestingLocationId String? // ward/ICU/ED/OT store (StockLocation) the request is FOR
  fulfillLocationId    String? // pharmacy StockLocation fulfilling it
  patientId            String?
  encounterId          String?
  priority             RequestPriority       @default(ROUTINE)
  status               PharmacyRequestStatus @default(REQUESTED)
  requestedByStaffId   String
  reviewedByStaffId    String?
  reservationId        String?
  transferId           String?
  reason               String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([facilityId, status])
  @@index([itemId])
  @@index([encounterId])
}

/**
 * Medication return workflow. A return NEVER silently re-enters available stock:
 * it lands PENDING_INSPECTION and an explicit classification (RETURN_TO_STOCK /
 * QUARANTINE / WASTAGE) drives the canonical inventory movement (a receipt-style
 * adjustment, quarantineLot, or recordWaste respectively). Controlled returns
 * carry a witness. patient/encounter/facility/item/lot are validated server-side.
 */
model MedicationReturn {
  id                 String                          @id @default(cuid())
  facilityId         String
  medicationOrder    MedicationOrder?                @relation(fields: [medicationOrderId], references: [id])
  medicationOrderId  String?
  itemId             String
  itemLotId          String?
  locationId         String
  quantity           Float
  unit               String?
  source             MedicationReturnSource
  classification     MedicationReturnClassification?
  status             MedicationReturnStatus          @default(PENDING_INSPECTION)
  patientId          String?
  encounterId        String?
  isControlled       Boolean                         @default(false)
  witnessStaffId     String?
  returnedByStaffId  String
  inspectedByStaffId String?
  reason             String?
  notes              String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  @@index([facilityId, status])
  @@index([itemId])
  @@index([medicationOrderId])
}

/**
 * Medication/lot recall over the canonical Item/ItemLot. Creating an OPEN recall
 * quarantines the affected lot(s) (LotStatus.RECALLED via the canonical lot
 * service) so they can no longer be issued. Inventory history is never deleted.
 * Not a national recall network — a local operational foundation.
 */
model MedicationRecall {
  id                String                 @id @default(cuid())
  facilityId        String
  itemId            String
  itemLotId         String?
  manufacturer      String?
  batchRef          String?
  reason            String
  reference         String?
  status            MedicationRecallStatus @default(OPEN)
  effectiveAt       DateTime               @default(now())
  affectedLocations Json?
  createdByStaffId  String
  closedByStaffId   String?
  closedAt          DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([facilityId, status])
  @@index([itemId])
  @@index([itemLotId])
}

/**
 * Explicitly-authorized medication substitution (brief §23). The system NEVER
 * recommends or auto-selects a substitution — this records that an authorized
 * clinician/pharmacist made one, with the original + replacement + reason.
 */
model MedicationSubstitution {
  id                  String          @id @default(cuid())
  facilityId          String
  medicationOrder     MedicationOrder @relation(fields: [medicationOrderId], references: [id])
  medicationOrderId   String
  originalDrugName    String
  replacementItemId   String?
  replacementDrugName String
  reason              String
  authorizedByStaffId String
  createdAt           DateTime        @default(now())

  @@index([facilityId])
  @@index([medicationOrderId])
}

/**
 * Documentary pharmacy storage check (brief §20) — a recorded reading for a
 * location (e.g. a refrigerator temperature). No IoT/telemetry, no automatic
 * clinical interpretation; just an auditable manual record.
 */
model PharmacyStorageCheck {
  id                String   @id @default(cuid())
  facilityId        String
  locationId        String
  recordedValue     Float
  unit              String
  status            String? // "OK" | "EXCURSION" — a recorded label, not an inference
  recordedByStaffId String
  notes             String?
  checkedAt         DateTime @default(now())

  @@index([facilityId, locationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Phase B7 — Advanced Diagnostics: LIS quality management + external lab.
// Additive operational-depth records over the Phase 4 diagnostics core
// (Specimen/LabResult/ImagingStudy/ImagingReport lifecycles are reused, not
// rebuilt). QC/calibration are quality-management DOCUMENTATION — never a
// scientific analyzer engine and never a source of clinical claims. The
// external-lab record is a clean referral/result-exchange boundary, NOT a live
// integration. facilityId/patientId/encounterId/labOrderId are plain FKs
// validated server-side (same pattern as the B5-B6 child records) — no
// canonical entity is duplicated.
// ─────────────────────────────────────────────────────────────────────────

enum LabQcReviewStatus {
  PENDING
  REVIEWED
  REJECTED
}

enum ExternalLabStatus {
  DRAFT
  SENT
  RESULT_RECEIVED
  REVIEWED
  CANCELLED
}

/**
 * Documentary laboratory QC run record (brief §15). Not an analyzer QC engine.
 */
model LabQcRecord {
  id                 String            @id @default(cuid())
  facilityId         String
  catalogTestId      String?
  instrumentId       String
  runAt              DateTime          @default(now())
  controlType        String // documentary, e.g. "LOW" | "NORMAL" | "HIGH"
  controlLot         String?
  observedValue      Float?
  expectedValue      Float?
  unit               String?
  result             String? // documentary "PASS" | "FAIL" label entered by staff, never computed as a clinical claim
  status             LabQcReviewStatus @default(PENDING)
  performedByStaffId String
  reviewedByStaffId  String?
  reviewedAt         DateTime?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([facilityId, status])
  @@index([instrumentId])
}

/**
 * Documentary instrument calibration record (brief §15).
 */
model LabCalibrationRecord {
  id                 String            @id @default(cuid())
  facilityId         String
  instrumentId       String
  calibrationType    String
  calibratedAt       DateTime          @default(now())
  status             LabQcReviewStatus @default(PENDING)
  performedByStaffId String
  reviewedByStaffId  String?
  reviewedAt         DateTime?
  nextDueAt          DateTime?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([facilityId, status])
  @@index([instrumentId])
}

/**
 * External-laboratory referral boundary (brief §16). Records that a test was
 * sent out and its result/document reference came back — a clean seam for a
 * future connector, NOT a live external integration. patient/encounter/order
 * are validated server-side; the result is a reference/document link, never
 * fabricated values.
 */
model ExternalLabReferral {
  id                String            @id @default(cuid())
  facilityId        String
  labOrderId        String?
  patientId         String
  encounterId       String?
  externalLabName   String
  externalAccession String?
  testDescription   String?
  status            ExternalLabStatus @default(DRAFT)
  sentByStaffId     String
  sentAt            DateTime?
  resultReceivedAt  DateTime?
  resultDocumentRef String?
  reviewedByStaffId String?
  reviewedAt        DateTime?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([facilityId, status])
  @@index([patientId])
  @@index([labOrderId])
}
